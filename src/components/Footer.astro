---
import { siteConfig, getRelativePath } from '@/site.config';
const currentYear = new Date().getFullYear();
const showFooterPrivacyNote = siteConfig.privacy?.footerNote !== false;
---

<footer class="w-full bg-surface border-t border-outline-variant py-8 mt-16 transition-colors">
  <div class="max-w-[1040px] mx-auto px-4 md:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] font-mono">
    <!-- Left: Author & Copyright -->
    <div class="text-on-surface-variant flex items-center gap-2">
      <span class="text-primary font-bold">&gt;</span>
      <span class="text-on-surface font-medium" data-footer-brand>© {currentYear} {siteConfig.name}</span>
    </div>

    <!-- Center: Privacy Note (if enabled) -->
    {showFooterPrivacyNote && (
      <div data-footer-privacy-note class="text-[11px] text-outline font-mono text-center">
        Privacy-first blog · No cookies or trackers
      </div>
    )}

    <!-- Right: Terminal Social & Feed Coordinates -->
    <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3 text-on-surface-variant text-[12px]">
      {siteConfig.githubUrl && (
        <a
          href={siteConfig.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
          data-footer-github
        >
          <span>GitHub</span>
        </a>
      )}
      {siteConfig.twitterUrl && (
        <>
          {siteConfig.githubUrl && <span class="text-outline">·</span>}
          <a
            href={siteConfig.twitterUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
            data-footer-twitter
          >
            <span>Twitter</span>
          </a>
        </>
      )}
      {siteConfig.email && (
        <>
          {(siteConfig.githubUrl || siteConfig.twitterUrl) && <span class="text-outline">·</span>}
          <a
            href={`mailto:${siteConfig.email}`}
            class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
            data-footer-email
          >
            <span>Email</span>
          </a>
        </>
      )}
      {(siteConfig.githubUrl || siteConfig.twitterUrl || siteConfig.email) && <span class="text-outline">·</span>}
      <a
        href={getRelativePath('/feed.xml')}
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1 text-primary"
      >
        <span>RSS</span>
      </a>
    </div>
  </div>

  <script is:inline>
    function updateFooterPrivacy() {
      try {
        const raw = localStorage.getItem('pomegranate_privacy');
        if (raw) {
          const p = JSON.parse(raw);
          const noteEl = document.querySelector('[data-footer-privacy-note]');
          if (noteEl) {
            if (p.footerNote === false) {
              noteEl.style.display = 'none';
            } else {
              noteEl.style.display = '';
            }
          }
        }
      } catch {}
    }
    updateFooterPrivacy();
    document.addEventListener('astro:page-load', updateFooterPrivacy);
    window.addEventListener('storage', updateFooterPrivacy);
  </script>
</footer>
