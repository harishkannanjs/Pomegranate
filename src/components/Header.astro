---
import ThemeToggle from './ThemeToggle.astro';
import ThemePackSelector from './ThemePackSelector.astro';
import { siteConfig, getRelativePath } from '@/site.config';

interface Props {
  activePath?: string;
  isDev?: boolean;
}

const { activePath = '/', isDev = import.meta.env.DEV } = Astro.props;
const navLinks: { href: string; label: string }[] = [];
const homeUrl = getRelativePath('/');
const targetProfileUrl = isDev ? getRelativePath('/profile/') : getRelativePath('/about/');
const isProfileActive = isDev
  ? activePath === '/profile' || activePath === '/profile/' || activePath === targetProfileUrl || activePath.startsWith(targetProfileUrl)
  : activePath === '/about' || activePath === '/about/' || activePath === targetProfileUrl || activePath.startsWith(targetProfileUrl);
const avatarSrc = siteConfig.avatar || siteConfig.logo ? getRelativePath(siteConfig.avatar || siteConfig.logo) : '';
---

<header class="fixed top-0 left-0 right-0 z-40 bg-surface/90 backdrop-blur-md border-b border-outline-variant transition-colors">
  <div class="h-14 max-w-[1040px] mx-auto px-4 md:px-8 flex items-center justify-between">
    <!-- Left: Brand & Nav -->
    <div class="flex items-center gap-6 md:gap-8">
      <a href={homeUrl} class="flex items-center gap-0.5 font-mono text-[14px] hover:opacity-90 transition-opacity">
        <span class="text-primary font-bold">&gt;</span>
        <span class="text-on-surface font-semibold tracking-tight" data-author-brand>pomegranate_</span>
      </a>
      {navLinks.length > 0 && (
        <nav class="flex items-center gap-4 text-[13px] font-mono">
          {navLinks.map((link) => {
            const isActive = activePath === link.href || (link.href !== '/' && activePath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`transition-colors hover:underline underline-offset-4 ${
                  isActive
                    ? 'text-primary font-bold'
                    : 'text-on-surface-variant hover:text-on-surface'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })}
        </nav>
      )}
    </div>

    <!-- Right: Search, Theme Toggle, UID -->
    <div class="flex items-center gap-3">
      <button
        type="button"
        id="header-search-btn"
        class="flex items-center gap-2 bg-surface-container border border-outline-variant hover:border-outline px-2.5 py-1 rounded-[2px] text-[11px] text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer"
        title="Search (Ctrl+K or /)"
      >
        <span class="text-primary font-mono font-bold">></span>
        <span class="hidden sm:inline">Search</span>
        <kbd class="px-1 bg-surface-container-high text-primary border border-outline-variant rounded-[2px] text-[10px] font-mono">/</kbd>
      </button>

      <ThemePackSelector />
      <ThemeToggle />

      <a
        href={targetProfileUrl}
        class={`flex items-center justify-center w-7 h-7 rounded-[2px] transition-colors border overflow-hidden ${
          isProfileActive
            ? 'border-primary text-primary bg-surface-container-high'
            : 'bg-surface-container border-outline-variant hover:border-primary text-on-surface-variant hover:text-primary'
        }`}
        title={isDev ? 'Dashboard' : 'About'}
        aria-label={isDev ? 'Dashboard' : 'About'}
      >
        <img
          src={avatarSrc}
          alt={siteConfig.githubUsername}
          class={`w-full h-full object-cover ${avatarSrc ? '' : 'hidden'}`}
          data-header-avatar
          onerror="this.classList.add('hidden'); const fallback = this.nextElementSibling; if (fallback) fallback.classList.remove('hidden');"
        />
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={`w-3.5 h-3.5 ${siteConfig.avatar || siteConfig.logo ? 'hidden' : ''}`}
          data-header-avatar-fallback
          aria-hidden="true"
        >
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
      </a>
    </div>
  </div>
</header>
