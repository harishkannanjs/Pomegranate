---
interface Props {
  code?: string;
  caption?: string;
}

const { code, caption } = Astro.props;
---

<figure class="my-8 border border-outline-variant bg-surface-container-low rounded-[2px] p-4 font-mono text-[12px] mermaid-wrapper">
  {caption && (
    <figcaption class="flex items-center justify-between pb-3 mb-3 border-b border-outline-variant text-[11px] text-outline select-none">
      <div class="flex items-center gap-1.5">
        <span class="text-primary font-bold">&gt;</span>
        <span>{caption}</span>
      </div>
      <span class="text-on-surface-variant font-mono text-[10px]">DIAGRAM // MERMAID</span>
    </figcaption>
  )}
  <div class="mermaid-diagram flex justify-center overflow-x-auto py-2">
    <pre class="mermaid text-on-surface" style="background: transparent !important; border: none !important; padding: 0 !important;">
      {code ? code.trim() : <slot />}
    </pre>
  </div>
</figure>

<script>
  async function renderMermaid() {
    const diagrams = document.querySelectorAll('.mermaid');
    if (diagrams.length === 0) return;

    // Cache original diagram code before Mermaid mutates DOM
    diagrams.forEach((diagram) => {
      const original = diagram.getAttribute('data-original-code');
      if (!original) {
        diagram.setAttribute('data-original-code', diagram.textContent || '');
      } else {
        diagram.removeAttribute('data-processed');
        diagram.textContent = original;
      }
    });

    try {
      // @ts-ignore
      const mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')).default;
      const isDark = document.documentElement.classList.contains('dark');
      
      const style = getComputedStyle(document.documentElement);
      const font = style.getPropertyValue('--font-theme').trim() || 'JetBrains Mono, monospace';
      const readBgBase = style.getPropertyValue('--read-bg-base').trim() || (isDark ? '#1e1e2e' : '#ffffff');
      const readBgSurface = style.getPropertyValue('--read-bg-surface').trim() || (isDark ? '#181825' : '#eff1f5');
      const readBgSurfaceRaised = style.getPropertyValue('--read-bg-surface-raised').trim() || (isDark ? '#313244' : '#e6e9ef');
      const readBorder = style.getPropertyValue('--read-border').trim() || (isDark ? '#45475a' : '#ccd0da');
      const readBorderStrong = style.getPropertyValue('--read-border-strong').trim() || (isDark ? '#585b70' : '#bcc0cc');
      const readTextPrimary = style.getPropertyValue('--read-text-primary').trim() || (isDark ? '#cdd6f4' : '#4c4f69');
      const readAccent = style.getPropertyValue('--read-accent').trim() || (isDark ? '#89b4fa' : '#1e66f5');

      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        themeVariables: {
          fontFamily: font,
          primaryColor: readBgSurfaceRaised,
          primaryTextColor: readTextPrimary,
          primaryBorderColor: readAccent,
          lineColor: readBorderStrong,
          secondaryColor: readBgSurface,
          tertiaryColor: readBorder,
          background: readBgBase,
        },
        securityLevel: 'loose',
      });

      await mermaid.run({
        querySelector: '.mermaid',
      });
    } catch (err) {
      console.warn('Mermaid render error:', err);
    }
  }

  renderMermaid();
  document.addEventListener('astro:after-swap', renderMermaid);
  window.addEventListener('theme-pack-change', () => setTimeout(renderMermaid, 50));
  window.addEventListener('theme-change', () => setTimeout(renderMermaid, 50));
</script>
