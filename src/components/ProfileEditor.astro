---
import { siteConfig, getRelativePath } from '@/site.config';

const currentProfile = {
  author: siteConfig.author !== 'Author' ? siteConfig.author : '',
  handle: siteConfig.handle !== '@user' ? siteConfig.handle : '',
  avatar: siteConfig.avatar || siteConfig.logo || '',
  logo: siteConfig.logo || siteConfig.avatar || '',
  role: siteConfig.role || '',
  twitterHandle: siteConfig.twitterHandle || '',
  title: siteConfig.title || '',
  description: siteConfig.description || '',
  siteUrl: siteConfig.siteUrl !== 'https://example.com' ? siteConfig.siteUrl : '',
  githubUrl: siteConfig.githubUrl || '',
  twitterUrl: siteConfig.twitterUrl || '',
  email: siteConfig.email || '',
  postsPerPage: siteConfig.postsPerPage || 10,
  giscus: siteConfig.giscus,
};
---

<!-- Localhost Dev Mode Toolbar (Visible ONLY in local development) -->
<div id="profile-dev-toolbar" class="hidden items-center gap-2 font-mono">
  <span class="text-primary text-[10px] font-bold px-1.5 py-0.5 bg-primary/10 border border-primary/30 rounded-[2px] hidden sm:inline">[DEV // LOCALHOST]</span>
  <button
    id="edit-profile-btn"
    type="button"
    class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-surface-container border border-outline-variant hover:border-primary text-primary hover:text-primary text-[11px] rounded-[2px] cursor-pointer transition-colors"
    title="Edit repository profile details (shortcut: 'e')"
  >
    <span class="font-bold">&gt;</span>
    <span>$ edit-profile</span>
    <kbd class="hidden sm:inline px-1 py-0.2 bg-surface-container-high text-outline text-[9px] border border-outline-variant rounded-[2px]">e</kbd>
  </button>

  <button
    id="export-config-btn"
    type="button"
    class="inline-flex items-center gap-1 px-2 py-1 bg-surface-container border border-outline-variant hover:border-outline text-on-surface-variant hover:text-on-surface text-[11px] rounded-[2px] cursor-pointer transition-colors"
    title="View or copy profile.json snippet for git commit"
  >
    <span>⎘ profile.json</span>
  </button>

  <button
    id="git-push-btn"
    type="button"
    class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-surface-container border border-outline-variant hover:border-primary text-primary hover:text-primary text-[11px] rounded-[2px] cursor-pointer transition-colors"
    title="Push current local codebase changes to GitHub repository (Localhost only)"
  >
    <span class="font-bold">↑</span>
    <span>push to github</span>
  </button>
</div>

<!-- Floating Terminal Toast Notification -->
<div
  id="profile-toast"
  class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-200 pointer-events-none bg-surface-container-highest border border-primary text-primary text-[12px] font-mono px-3.5 py-2 rounded-[2px] shadow-lg flex items-center gap-2"
  role="status"
  aria-live="polite"
>
  <span class="font-bold text-primary" id="profile-toast-icon">✔</span>
  <span class="text-on-surface" id="profile-toast-msg">Profile updated</span>
</div>

<!-- Interactive Profile Editor Modal Dialog -->
<div
  id="profile-editor-modal"
  class="fixed inset-0 z-50 bg-black/75 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden font-mono"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="editor-title"
>
  <div class="w-full max-w-[680px] max-h-[90vh] flex flex-col bg-surface border border-outline rounded-[2px] shadow-2xl overflow-hidden">
    <!-- Terminal Header Bar -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-surface-container border-b border-outline-variant select-none">
      <div class="flex items-center gap-2 text-[12px]">
        <span class="w-2.5 h-2.5 rounded-full bg-error inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-primary inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-outline inline-block"></span>
        <span id="editor-title" class="font-semibold text-on-surface ml-1">
          profile.json — Repository Config Editor
        </span>
      </div>
      <button
        id="close-editor-btn"
        type="button"
        class="text-on-surface-variant hover:text-primary text-[14px] leading-none px-1.5 py-0.5 border border-transparent hover:border-outline-variant rounded-[2px] cursor-pointer"
        title="Close editor (Esc)"
      >
        ✕
      </button>
    </div>

    <!-- Terminal Editor Body / Form -->
    <form id="profile-editor-form" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 text-[12px]">
      <div class="p-2.5 bg-surface-container-lowest border border-outline-variant text-[11px] text-on-surface-variant leading-relaxed">
        <span class="text-primary font-bold"># LOCAL DEV MODE:</span> All details are stored directly in <code class="text-primary">profile.json</code> in your repository. Saving updates your preview and exports the configuration to commit to Git.
      </div>

      <!-- Logo / Avatar Upload & Repository Sync Card -->
      <div class="p-3 bg-surface-container-low border border-outline-variant rounded-[2px] flex items-center justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 shrink-0 bg-surface-container border border-outline-variant relative overflow-hidden flex items-center justify-center rounded-[2px]">
            <img
              id="modal-logo-preview-img"
              src={currentProfile.avatar ? getRelativePath(currentProfile.avatar) : ''}
              alt="Logo Preview"
              class={`w-full h-full object-cover ${currentProfile.avatar ? '' : 'hidden'}`}
            />
            <div
              id="modal-logo-preview-fallback"
              class={`flex flex-col items-center justify-center text-primary text-[14px] font-bold ${currentProfile.avatar ? 'hidden' : ''}`}
            >
              &gt;_
            </div>
          </div>
          <div class="flex flex-col space-y-0.5">
            <span class="text-on-surface font-semibold text-[12px]">Profile / Author Logo</span>
            <span class="text-outline text-[10px]">Saved to repository at <code class="text-primary font-mono">public/profile-logo.*</code></span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <input
            type="file"
            id="modal-logo-file-input"
            accept="image/png,image/jpeg,image/webp,image/svg+xml,image/gif"
            class="hidden"
          />
          <button
            type="button"
            id="modal-upload-logo-btn"
            class="px-2.5 py-1 bg-surface-container border border-outline-variant hover:border-primary text-primary text-[11px] rounded-[2px] cursor-pointer transition-colors font-medium"
          >
            Upload Logo
          </button>
          <button
            type="button"
            id="modal-remove-logo-btn"
            class="px-2 py-1 bg-surface-container border border-outline-variant hover:border-error text-outline hover:text-error text-[11px] rounded-[2px] cursor-pointer transition-colors"
            title="Remove logo and use terminal >_ fallback"
          >
            Remove
          </button>
        </div>
      </div>

      <!-- Two-column Grid of Profile Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <!-- Display Name -->
        <div class="flex flex-col space-y-1">
          <label for="prof-author" class="text-[11px] text-outline uppercase tracking-wider flex justify-between">
            <span>author.name</span>
            <span class="text-primary font-bold">*</span>
          </label>
          <input
            type="text"
            id="prof-author"
            name="author"
            required
            class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
            placeholder="e.g. Alex Doe"
          />
        </div>

        <!-- Terminal Handle -->
        <div class="flex flex-col space-y-1">
          <label for="prof-handle" class="text-[11px] text-outline uppercase tracking-wider flex justify-between">
            <span>author.handle</span>
            <span class="text-outline text-[10px]">(@username)</span>
          </label>
          <input
            type="text"
            id="prof-handle"
            name="handle"
            class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
            placeholder="e.g. @alex"
          />
        </div>

        <!-- Role / Title -->
        <div class="flex flex-col space-y-1 sm:col-span-2">
          <label for="prof-role" class="text-[11px] text-outline uppercase tracking-wider">
            author.role
          </label>
          <input
            type="text"
            id="prof-role"
            name="role"
            class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
            placeholder="e.g. Software Engineer, Designer, Writer, Researcher"
          />
        </div>

        <!-- Bio / Description -->
        <div class="flex flex-col space-y-1 sm:col-span-2">
          <div class="flex justify-between items-center text-[11px] text-outline uppercase tracking-wider">
            <label for="prof-description">author.description</label>
            <span id="prof-bio-count" class="text-[10px] text-outline">0 chars</span>
          </div>
          <textarea
            id="prof-description"
            name="description"
            rows="2"
            class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline resize-none"
            placeholder="Brief description about yourself, your work, and your projects."
          ></textarea>
        </div>

        <!-- Website / Site URL -->
        <div class="flex flex-col space-y-1 sm:col-span-2">
          <label for="prof-siteurl" class="text-[11px] text-outline uppercase tracking-wider">
            author.siteUrl
          </label>
          <input
            type="text"
            id="prof-siteurl"
            name="siteUrl"
            class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
            placeholder="https://yourusername.github.io"
          />
        </div>

        <!-- GitHub URL -->
        <div class="flex flex-col space-y-1">
          <label for="prof-github" class="text-[11px] text-outline uppercase tracking-wider">
            author.github
          </label>
          <input
            type="text"
            id="prof-github"
            name="githubUrl"
            class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
            placeholder="https://github.com/username"
          />
        </div>

        <!-- Twitter / X URL -->
        <div class="flex flex-col space-y-1">
          <label for="prof-twitter" class="text-[11px] text-outline uppercase tracking-wider">
            author.twitter
          </label>
          <input
            type="text"
            id="prof-twitter"
            name="twitterUrl"
            class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
            placeholder="https://x.com/username"
          />
        </div>

        <!-- Email Address -->
        <div class="flex flex-col space-y-1">
          <label for="prof-email" class="text-[11px] text-outline uppercase tracking-wider">
            author.email
          </label>
          <input
            type="email"
            id="prof-email"
            name="email"
            class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
            placeholder="e.g. you@example.com"
          />
        </div>

        <!-- Giscus Comments Configuration -->
        <div class="flex flex-col space-y-2 sm:col-span-2 pt-2 border-t border-outline-variant">
          <div class="flex justify-between items-center text-[11px] text-outline uppercase tracking-wider">
            <span class="text-primary font-semibold">giscus.comments (GitHub Discussions)</span>
            <a href="https://giscus.app" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline lowercase">
              [get IDs on giscus.app ↗]
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="flex flex-col space-y-1">
              <label for="prof-giscus-repo" class="text-[10px] text-outline uppercase tracking-wider">giscus.repo</label>
              <input
                type="text"
                id="prof-giscus-repo"
                name="giscusRepo"
                class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
                placeholder="e.g. username/blog"
              />
            </div>
            <div class="flex flex-col space-y-1">
              <label for="prof-giscus-repoid" class="text-[10px] text-outline uppercase tracking-wider">giscus.repoId</label>
              <input
                type="text"
                id="prof-giscus-repoid"
                name="giscusRepoId"
                class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
                placeholder="e.g. R_kgD..."
              />
            </div>
            <div class="flex flex-col space-y-1">
              <label for="prof-giscus-category" class="text-[10px] text-outline uppercase tracking-wider">giscus.category</label>
              <input
                type="text"
                id="prof-giscus-category"
                name="giscusCategory"
                class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
                placeholder="e.g. General"
              />
            </div>
            <div class="flex flex-col space-y-1">
              <label for="prof-giscus-categoryid" class="text-[10px] text-outline uppercase tracking-wider">giscus.categoryId</label>
              <input
                type="text"
                id="prof-giscus-categoryid"
                name="giscusCategoryId"
                class="bg-surface-container-lowest border border-outline-variant focus:border-primary px-2.5 py-1.5 rounded-[2px] font-mono text-[12px] text-on-surface focus:outline-none placeholder:text-outline"
                placeholder="e.g. DIC_kwD..."
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Actions Footer -->
      <div class="flex flex-wrap items-center justify-end gap-3 pt-4 border-t border-outline-variant">
        <button
          type="button"
          id="cancel-editor-btn"
          class="px-3 py-1.5 bg-surface-container border border-outline-variant hover:border-outline text-on-surface text-[11px] rounded-[2px] cursor-pointer transition-colors"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="px-4 py-1.5 bg-primary text-on-primary font-semibold text-[11px] rounded-[2px] cursor-pointer hover:opacity-90 transition-opacity flex items-center gap-1.5"
        >
          <span>✔</span>
          <span>Save to profile.json</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Export Config Modal -->
<div
  id="profile-export-modal"
  class="fixed inset-0 z-50 bg-black/75 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden font-mono"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="export-title"
>
  <div class="w-full max-w-[620px] max-h-[85vh] flex flex-col bg-surface border border-outline rounded-[2px] shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between px-4 py-2.5 bg-surface-container border-b border-outline-variant select-none">
      <div class="flex items-center gap-2 text-[12px]">
        <span class="text-primary font-bold">&gt;</span>
        <span id="export-title" class="font-semibold text-on-surface">
          profile.json (Repository Source)
        </span>
      </div>
      <button
        id="close-export-btn"
        type="button"
        class="text-on-surface-variant hover:text-primary text-[14px] leading-none px-1.5 py-0.5 border border-transparent hover:border-outline-variant rounded-[2px] cursor-pointer"
        title="Close (Esc)"
      >
        ✕
      </button>
    </div>

    <div class="p-4 sm:p-5 flex-1 overflow-y-auto space-y-3 text-[12px]">
      <p class="text-[11px] text-outline">
        This file is stored in your repository at <code class="text-primary">profile.json</code>. Commit any changes to Git to publish to your <code class="text-primary">github.io</code> blog:
      </p>

      <div class="relative group">
        <pre class="p-3 bg-surface-container-lowest border border-outline-variant text-[11px] text-on-surface overflow-x-auto rounded-[2px] leading-relaxed select-all" id="export-code-block"></pre>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 px-4 py-3 bg-surface-container border-t border-outline-variant">
      <button
        type="button"
        id="prof-download-json-btn"
        class="px-3 py-1.5 bg-surface-container border border-outline-variant hover:border-outline text-on-surface text-[11px] rounded-[2px] cursor-pointer transition-colors"
      >
        Download JSON
      </button>
      <button
        type="button"
        id="close-export-btn-2"
        class="px-3 py-1.5 bg-surface-container border border-outline-variant hover:border-outline text-on-surface text-[11px] rounded-[2px] cursor-pointer transition-colors"
      >
        Close
      </button>
      <button
        type="button"
        id="copy-export-code-btn"
        class="px-3.5 py-1.5 bg-primary text-on-primary font-semibold text-[11px] rounded-[2px] cursor-pointer hover:opacity-90 transition-opacity flex items-center gap-1.5"
      >
        <span id="copy-export-icon">⎘</span>
        <span id="copy-export-text">Copy JSON</span>
      </button>
    </div>
  </div>
</div>

<!-- Push to GitHub Modal Dialog (Strictly Localhost Only) -->
<div
  id="git-push-modal"
  class="fixed inset-0 z-50 bg-black/75 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden font-mono"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="git-push-title"
>
  <div class="w-full max-w-[640px] max-h-[90vh] flex flex-col bg-surface border border-outline rounded-[2px] shadow-2xl overflow-hidden">
    <!-- Terminal Header Bar -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-surface-container border-b border-outline-variant select-none">
      <div class="flex items-center gap-2 text-[12px]">
        <span class="w-2.5 h-2.5 rounded-full bg-error inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-primary inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-outline inline-block"></span>
        <span id="git-push-title" class="font-semibold text-on-surface ml-1">
          git push — Push Codebase to GitHub
        </span>
      </div>
      <button
        id="close-git-push-btn"
        type="button"
        class="text-on-surface-variant hover:text-primary text-[14px] leading-none px-1.5 py-0.5 border border-transparent hover:border-outline-variant rounded-[2px] cursor-pointer"
        title="Close (Esc)"
      >
        ✕
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-4 sm:p-5 flex-1 overflow-y-auto space-y-3.5 text-[12px]">
      <!-- Incomplete Profile Details Warning Box -->
      <div
        id="git-profile-warning"
        class="p-3 bg-error/10 border border-error/50 text-error rounded-[2px] flex items-center justify-between gap-3 hidden"
      >
        <div class="flex items-start gap-2 text-[11px] leading-relaxed">
          <span class="text-[15px] leading-none shrink-0 mt-0.5">⚠️</span>
          <div>
            <div class="font-bold text-[12px] text-error">Fill the profile details first to proceed github push</div>
            <div class="text-on-surface-variant text-[10.5px] mt-0.5">
              Your profile in <code class="text-primary font-mono">profile.json</code> is not yet configured. Please fill in your author name and GitHub username first.
            </div>
          </div>
        </div>
        <button
          type="button"
          id="git-open-profile-btn"
          class="px-3 py-1.5 bg-surface-container border border-error/60 hover:border-error text-error hover:bg-error/20 text-[11px] font-bold rounded-[2px] cursor-pointer shrink-0 transition-colors flex items-center gap-1"
        >
          <span>&gt;</span>
          <span>$ edit-profile</span>
        </button>
      </div>

      <!-- Top Branch & Repository Settings Card -->
      <div class="p-3 bg-surface-container-low border border-outline-variant rounded-[2px] space-y-2.5">
        <!-- Top Row: Branch Dropdown Selector (Main / Master) & Git Status -->
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="text-primary font-bold">&gt;</span>
            <label for="git-push-branch-select" class="text-on-surface font-semibold text-[11px]">
              Branch:
            </label>
            <div class="relative inline-block">
              <select
                id="git-push-branch-select"
                class="bg-surface-container border border-outline-variant hover:border-primary text-primary text-[11px] font-bold font-mono px-2.5 py-1 rounded-[2px] focus:outline-none focus:border-primary cursor-pointer transition-colors"
              >
                <option value="main">Main</option>
                <option value="master">Master</option>
              </select>
            </div>
            <span class="text-outline text-[10px] hidden sm:inline">(select "Main" or "Master" branch to push)</span>
          </div>

          <div class="flex items-center gap-2 text-[11px]">
            <span id="git-push-status-dot" class="w-2 h-2 rounded-full bg-outline inline-block"></span>
            <span id="git-push-status-text" class="text-on-surface-variant text-[11px]">Checking git status...</span>
            <button
              type="button"
              id="git-refresh-status-btn"
              class="text-[10px] text-primary hover:underline cursor-pointer ml-1"
              title="Re-check git status and profile.json"
            >
              ⟳ refresh
            </button>
          </div>
        </div>

        <!-- Target Repository URL (Auto-filled from profile.json) -->
        <div class="space-y-1 pt-1.5 border-t border-outline-variant/60">
          <div class="flex items-center justify-between text-[11px]">
            <label for="git-push-repo-input" class="text-on-surface font-semibold flex items-center gap-1.5">
              <span>Target Repository URL:</span>
              <span id="git-repo-badge" class="text-primary text-[10px] font-mono px-1.5 py-0.2 bg-primary/10 border border-primary/30 rounded-[2px]">auto-filled from profile.json</span>
            </label>
            <a
              id="git-view-repo-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[10px] text-primary hover:underline flex items-center gap-0.5 hidden"
            >
              <span>view on github</span>
              <span>↗</span>
            </a>
          </div>
          <div class="relative">
            <input
              type="text"
              id="git-push-repo-input"
              class="w-full bg-surface-container-lowest px-3 py-1.5 text-[12px] font-mono border border-outline-variant focus:border-primary focus:outline-none text-primary rounded-[2px] transition-colors"
              placeholder="https://github.com/username/glyph.sh.git"
            />
          </div>
          <div id="git-repo-hint" class="text-[10px] text-outline">
            Username grabbed automatically from your saved profile details.
          </div>
        </div>
      </div>

      <!-- Pending Changes File List (Shown if modified files exist) -->
      <div id="git-changed-files-box" class="space-y-1.5 hidden">
        <div class="flex items-center justify-between text-[11px]">
          <span class="text-on-surface font-semibold">Pending Local Changes to Commit:</span>
          <span id="git-changed-files-count" class="text-outline text-[10px]">0 files</span>
        </div>
        <div
          id="git-changed-files-list"
          class="p-2.5 bg-surface-container-lowest border border-outline-variant text-[11px] text-on-surface font-mono max-h-[110px] overflow-y-auto rounded-[2px] space-y-1"
        ></div>
      </div>

      <!-- Commit Message Input -->
      <div class="space-y-1.5">
        <label for="git-commit-msg-input" class="block text-[11px] font-semibold text-on-surface">
          Commit Message <span class="text-outline font-normal">(optional — leave empty for no commit message):</span>
        </label>
        <input
          type="text"
          id="git-commit-msg-input"
          placeholder="Leave empty or enter commit message..."
          class="w-full bg-surface-container px-3 py-1.5 text-[12px] border border-outline-variant focus:border-primary focus:outline-none text-on-surface rounded-[2px]"
        />
      </div>

      <!-- Equivalent Terminal Command Block -->
      <div class="p-3 bg-surface-container-lowest border border-outline-variant rounded-[2px] space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-outline text-[10px] font-semibold uppercase tracking-wider">Equivalent Terminal Command:</span>
          <button
            type="button"
            id="copy-git-cmd-btn"
            class="text-[10px] text-primary hover:underline cursor-pointer flex items-center gap-1"
            title="Copy command to clipboard"
          >
            <span>⎘</span>
            <span id="copy-git-cmd-text">Copy Command</span>
          </button>
        </div>
        <pre id="git-cmd-preview" class="text-[11px] text-primary overflow-x-auto select-all leading-tight">git add -A &amp;&amp; git commit --allow-empty-message -m "" &amp;&amp; git push origin master</pre>
      </div>

      <!-- Real-time Console Log Output -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px]">
          <span class="text-outline text-[10px] font-semibold uppercase tracking-wider">Console Output:</span>
          <span id="git-console-status" class="text-[10px] text-outline">Ready</span>
        </div>
        <pre
          id="git-console-output"
          class="p-3 bg-surface-container-lowest border border-outline-variant text-[11px] text-on-surface-variant font-mono h-[110px] overflow-y-auto rounded-[2px] leading-relaxed select-all whitespace-pre-wrap"
        >Ready to push local codebase to GitHub. Click "Push to GitHub" below or run the terminal command above.</pre>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="flex items-center justify-between gap-2 px-4 py-3 bg-surface-container border-t border-outline-variant">
      <div id="git-footer-status" class="text-[11px] text-outline flex items-center gap-1.5 hidden sm:flex">
        <span class="text-primary font-mono">&gt;_</span>
        <span id="git-footer-status-text">Ready to push</span>
      </div>

      <div class="flex items-center gap-2 ml-auto">
        <button
          type="button"
          id="close-git-push-btn-2"
          class="px-3 py-1.5 bg-surface-container border border-outline-variant hover:border-outline text-on-surface text-[11px] rounded-[2px] cursor-pointer transition-colors"
        >
          Close
        </button>
        <button
          type="button"
          id="execute-git-push-btn"
          class="px-3.5 py-1.5 bg-primary text-on-primary font-semibold text-[11px] rounded-[2px] cursor-pointer hover:opacity-90 transition-opacity flex items-center gap-1.5"
        >
          <span id="git-push-btn-icon">↑</span>
          <span id="git-push-btn-text">Push to GitHub</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ currentProfile, baseUrl: getRelativePath('/') }}>
  (function () {
    let profile = { ...currentProfile };
    const isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';

    function resolveAssetUrl(url) {
      if (!url) return '';
      if (/^(?:[a-z]+:)?\/\//i.test(url) || url.startsWith('data:')) return url;
      const base = (typeof baseUrl !== 'undefined' ? baseUrl : '/').replace(/\/+$/, '');
      const clean = url.replace(/^\/+/, '');
      return base ? `${base}/${clean}` : `/${clean}`;
    }

    function updateAccessUI() {
      const devToolbar = document.getElementById('profile-dev-toolbar');
      const logoUploadOverlayBtn = document.getElementById('logo-upload-overlay-btn');
      const gitPushModal = document.getElementById('git-push-modal');
      if (isDev) {
        devToolbar?.classList.remove('hidden');
        devToolbar?.classList.add('flex');
        logoUploadOverlayBtn?.classList.remove('hidden');
        logoUploadOverlayBtn?.classList.add('flex');
      } else {
        devToolbar?.classList.add('hidden');
        devToolbar?.classList.remove('flex');
        logoUploadOverlayBtn?.classList.add('hidden');
        logoUploadOverlayBtn?.classList.remove('flex');
        gitPushModal?.remove();
      }
    }

    function showToast(message, isError = false) {
      const toast = document.getElementById('profile-toast');
      const msgEl = document.getElementById('profile-toast-msg');
      const iconEl = document.getElementById('profile-toast-icon');
      if (!toast || !msgEl || !iconEl) return;

      msgEl.textContent = message;
      iconEl.textContent = isError ? '✕' : '✔';
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      if (window._profileToastTimeout) clearTimeout(window._profileToastTimeout);
      window._profileToastTimeout = setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3200);
    }

    function applyProfile(p) {
      profile = { ...p };

      // Update Avatar / Logo Image & Fallback
      const hasLogo = Boolean(p.avatar || p.logo);
      const rawLogo = p.avatar || p.logo || '';
      const logoSrc = resolveAssetUrl(rawLogo);

      document.querySelectorAll('[data-profile-logo-img]').forEach((el) => {
        if (hasLogo) {
          el.src = logoSrc;
          el.classList.remove('hidden');
        } else {
          el.src = '';
          el.classList.add('hidden');
        }
      });

      document.querySelectorAll('[data-profile-logo-fallback]').forEach((el) => {
        if (hasLogo) {
          el.classList.add('hidden');
        } else {
          el.classList.remove('hidden');
        }
      });

      // Update Modal Preview
      const modalLogoImg = document.getElementById('modal-logo-preview-img');
      const modalLogoFallback = document.getElementById('modal-logo-preview-fallback');
      if (modalLogoImg && modalLogoFallback) {
        if (hasLogo) {
          modalLogoImg.src = logoSrc;
          modalLogoImg.classList.remove('hidden');
          modalLogoFallback.classList.add('hidden');
        } else {
          modalLogoImg.src = '';
          modalLogoImg.classList.add('hidden');
          modalLogoFallback.classList.remove('hidden');
        }
      }

      // Update Header Avatar if present
      document.querySelectorAll('[data-header-avatar]').forEach((el) => {
        if (hasLogo) {
          el.src = logoSrc;
          el.classList.remove('hidden');
        } else {
          el.src = '';
          el.classList.add('hidden');
        }
      });
      document.querySelectorAll('[data-header-avatar-fallback]').forEach((el) => {
        if (hasLogo) {
          el.classList.add('hidden');
        } else {
          el.classList.remove('hidden');
        }
      });

      // Update Avatar Handle
      document.querySelectorAll('[data-profile-handle]').forEach((el) => {
        el.textContent = p.handle || '';
      });

      // Update Author Name & Title
      document.querySelectorAll('[data-profile-author]').forEach((el) => {
        el.textContent = p.author || p.handle || 'User';
      });
      document.querySelectorAll('[data-profile-role]').forEach((el) => {
        el.textContent = p.role || '';
        if (p.role) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      document.querySelectorAll('[data-profile-bio]').forEach((el) => {
        el.textContent = p.description || 'No description provided yet.';
        if (p.description) {
          el.classList.remove('italic', 'text-outline');
        } else {
          el.classList.add('italic', 'text-outline');
        }
      });

      // Update Social & Contact links
      document.querySelectorAll('[data-profile-github-link]').forEach((el) => {
        el.href = p.githubUrl || '#';
        if (p.githubUrl) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      document.querySelectorAll('[data-profile-github-text]').forEach((el) => {
        el.textContent = `GitHub: ${p.handle || p.author || ''}`;
      });

      document.querySelectorAll('[data-profile-twitter-link]').forEach((el) => {
        el.href = p.twitterUrl || '#';
        if (p.twitterUrl) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      document.querySelectorAll('[data-profile-twitter-text]').forEach((el) => {
        el.textContent = `Twitter: ${p.twitterHandle || ''}`;
      });

      document.querySelectorAll('[data-profile-email-link]').forEach((el) => {
        el.href = p.email ? `mailto:${p.email}` : '#';
        if (p.email) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      document.querySelectorAll('[data-profile-email-text]').forEach((el) => {
        el.textContent = p.email || '';
      });

      // Separators
      document.querySelectorAll('[data-profile-sep-1]').forEach((el) => {
        if (p.githubUrl && p.twitterUrl) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      document.querySelectorAll('[data-profile-sep-2]').forEach((el) => {
        if ((p.githubUrl || p.twitterUrl) && p.email) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Update Section Header: "Published Posts by {author}"
      document.querySelectorAll('[data-profile-posts-author]').forEach((el) => {
        el.textContent = p.author ? `Published Posts by ${p.author}` : 'Published Posts';
      });

      // Keep Header Brand as blogly_
      document.querySelectorAll('[data-author-brand]').forEach((el) => {
        el.textContent = 'blogly_';
      });

      // Keep Footer Brand as Blogly
      document.querySelectorAll('[data-footer-brand]').forEach((el) => {
        el.textContent = `© ${new Date().getFullYear()} Blogly`;
      });

      // Update Footer Social links
      document.querySelectorAll('[data-footer-github]').forEach((el) => {
        if (p.githubUrl) {
          el.href = p.githubUrl;
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      document.querySelectorAll('[data-footer-twitter]').forEach((el) => {
        if (p.twitterUrl) {
          el.href = p.twitterUrl;
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      document.querySelectorAll('[data-footer-email]').forEach((el) => {
        if (p.email) {
          el.href = `mailto:${p.email}`;
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }

    function populateForm() {
      const form = document.getElementById('profile-editor-form');
      if (!form) return;

      const authorInp = form.querySelector('#prof-author');
      const handleInp = form.querySelector('#prof-handle');
      const roleInp = form.querySelector('#prof-role');
      const bioInp = form.querySelector('#prof-description');
      const siteUrlInp = form.querySelector('#prof-siteurl');
      const githubInp = form.querySelector('#prof-github');
      const twitterInp = form.querySelector('#prof-twitter');
      const emailInp = form.querySelector('#prof-email');
      const giscusRepoInp = form.querySelector('#prof-giscus-repo');
      const giscusRepoIdInp = form.querySelector('#prof-giscus-repoid');
      const giscusCategoryInp = form.querySelector('#prof-giscus-category');
      const giscusCategoryIdInp = form.querySelector('#prof-giscus-categoryid');

      if (authorInp) authorInp.value = profile.author || '';
      if (handleInp) handleInp.value = profile.handle || '';
      if (roleInp) roleInp.value = profile.role || '';
      if (bioInp) {
        bioInp.value = profile.description || '';
        const countEl = document.getElementById('prof-bio-count');
        if (countEl) countEl.textContent = `${bioInp.value.length} chars`;
      }
      if (siteUrlInp) siteUrlInp.value = profile.siteUrl || '';
      if (githubInp) githubInp.value = profile.githubUrl || '';
      if (twitterInp) twitterInp.value = profile.twitterUrl || '';
      if (emailInp) emailInp.value = profile.email || '';
      if (giscusRepoInp) giscusRepoInp.value = profile.giscus?.repo || '';
      if (giscusRepoIdInp) giscusRepoIdInp.value = profile.giscus?.repoId || '';
      if (giscusCategoryInp) giscusCategoryInp.value = profile.giscus?.category || 'General';
      if (giscusCategoryIdInp) giscusCategoryIdInp.value = profile.giscus?.categoryId || '';
    }

    async function openEditorModal() {
      if (!isDev) return;
      try {
        const res = await fetch('/api/get-profile');
        if (res.ok) {
          const data = await res.json();
          if (data.profile) {
            profile = { ...profile, ...data.profile };
          }
        }
      } catch {}
      populateForm();
      const modal = document.getElementById('profile-editor-modal');
      if (modal) {
        modal.style.display = 'flex';
        modal.classList.remove('hidden');
        const firstInput = modal.querySelector('#prof-author');
        if (firstInput) firstInput.focus();
      }
    }

    function closeEditorModal() {
      const modal = document.getElementById('profile-editor-modal');
      if (modal) {
        modal.style.display = 'none';
        modal.classList.add('hidden');
      }
    }

    function openExportModal() {
      const codeBlock = document.getElementById('export-code-block');
      if (codeBlock) {
        codeBlock.textContent = JSON.stringify(profile, null, 2);
      }
      const modal = document.getElementById('profile-export-modal');
      if (modal) {
        modal.style.display = 'flex';
        modal.classList.remove('hidden');
      }
    }

    function closeExportModal() {
      const modal = document.getElementById('profile-export-modal');
      if (modal) {
        modal.style.display = 'none';
        modal.classList.add('hidden');
      }
    }

    function formatHandle(str) {
      if (!str) return '';
      str = str.trim();
      return str.startsWith('@') ? str : `@${str}`;
    }

    function formatUrl(str, fallbackBase) {
      if (!str) return '';
      str = str.trim();
      if (/^https?:\/\//i.test(str)) return str;
      const clean = str.replace(/^@/, '');
      return fallbackBase ? `${fallbackBase.replace(/\/+$/, '')}/${clean}` : `https://${clean}`;
    }

    async function handleSave(e) {
      if (e) e.preventDefault();
      if (!isDev) return;

      const form = document.getElementById('profile-editor-form');
      if (!form) return;

      const rawAuthor = form.querySelector('#prof-author')?.value.trim() || '';
      const rawHandle = form.querySelector('#prof-handle')?.value.trim() || '';
      const handle = formatHandle(rawHandle);
      const role = form.querySelector('#prof-role')?.value.trim() || '';
      const description = form.querySelector('#prof-description')?.value.trim() || '';
      const rawSiteUrl = form.querySelector('#prof-siteurl')?.value.trim() || '';
      const siteUrl = rawSiteUrl ? formatUrl(rawSiteUrl) : (profile.siteUrl || 'https://example.com');
      const rawGithub = form.querySelector('#prof-github')?.value.trim() || '';
      const githubUrl = rawGithub ? formatUrl(rawGithub, 'https://github.com') : '';

      const rawTwitter = form.querySelector('#prof-twitter')?.value.trim() || '';
      const twitterUrl = rawTwitter ? formatUrl(rawTwitter, 'https://x.com') : '';
      const twitterHandle = rawTwitter ? formatHandle(rawTwitter.replace(/https?:\/\/(twitter|x)\.com\//, '')) : '';

      const email = form.querySelector('#prof-email')?.value.trim() || '';
      const giscusRepo = form.querySelector('#prof-giscus-repo')?.value.trim() || '';
      const giscusRepoId = form.querySelector('#prof-giscus-repoid')?.value.trim() || '';
      const giscusCategory = form.querySelector('#prof-giscus-category')?.value.trim() || 'General';
      const giscusCategoryId = form.querySelector('#prof-giscus-categoryid')?.value.trim() || '';

      const updated = {
        ...profile,
        author: rawAuthor,
        handle,
        avatar: profile.avatar || '',
        logo: profile.logo || '',
        role,
        twitterHandle,
        title: profile.title || "Blogly",
        description,
        siteUrl,
        githubUrl,
        twitterUrl,
        email,
        postsPerPage: profile.postsPerPage || 10,
        giscus: {
          enabled: Boolean(giscusRepo && giscusRepoId && giscusCategoryId),
          repo: giscusRepo,
          repoId: giscusRepoId,
          category: giscusCategory,
          categoryId: giscusCategoryId,
        },
      };

      profile = { ...profile, ...updated };
      applyProfile(profile);

      const saveBtn = form.querySelector('button[type="submit"]');
      if (saveBtn) saveBtn.disabled = true;

      try {
        const res = await fetch('/api/save-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updated),
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `HTTP ${res.status}`);
        }

        const resData = await res.json().catch(() => ({}));
        if (resData.profile) {
          profile = { ...profile, ...resData.profile };
          applyProfile(profile);
        }

        try {
          fetchGitStatus();
        } catch {}

        closeEditorModal();
        showToast('✔ Saved to profile.json in repository!');
        openExportModal();
      } catch (err) {
        console.error('Auto-save to profile.json error:', err);
        showToast('Failed to save to profile.json: ' + err.message, true);
      } finally {
        if (saveBtn) saveBtn.disabled = false;
      }
    }

    async function uploadLogoFile(file) {
      if (!isDev) return;
      if (!file) return;

      if (!file.type.startsWith('image/')) {
        showToast('Only image files (PNG, JPG, SVG, WebP, GIF) are supported', true);
        return;
      }

      if (file.size > 8 * 1024 * 1024) {
        showToast('Image size exceeds 8MB limit', true);
        return;
      }

      showToast('Uploading logo to repository...');

      const reader = new FileReader();
      reader.onload = async () => {
        try {
          const base64Data = reader.result;
          const res = await fetch('/api/upload-logo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              image: base64Data,
              filename: file.name,
            }),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.error || 'Failed to upload logo');
          }

          const data = await res.json();
          const timestampedUrl = `${resolveAssetUrl(data.url)}?t=${Date.now()}`;
          profile.avatar = data.url;
          profile.logo = data.url;

          applyProfile(profile);

          // Force fresh timestamped preview so browser cache is bypassed immediately
          document.querySelectorAll('[data-profile-logo-img]').forEach((el) => {
            el.src = timestampedUrl;
          });
          const modalImg = document.getElementById('modal-logo-preview-img');
          if (modalImg) modalImg.src = timestampedUrl;

          showToast('✔ Logo saved to repo (public/) & profile.json!');
        } catch (err) {
          console.error(err);
          showToast(err.message || 'Error uploading logo', true);
        }
      };
      reader.readAsDataURL(file);
    }

    async function removeLogo() {
      if (!isDev) return;
      profile.avatar = '';
      profile.logo = '';
      applyProfile(profile);

      try {
        await fetch('/api/save-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(profile),
        });
        showToast('Logo removed. Reverted to terminal >_');
      } catch (err) {
        showToast('Failed to update profile.json', true);
      }
    }

    function downloadJson() {
      const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(profile, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute('href', dataStr);
      downloadAnchor.setAttribute('download', 'profile.json');
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
      showToast('profile.json downloaded');
    }

    async function copyJson() {
      try {
        await navigator.clipboard.writeText(JSON.stringify(profile, null, 2));
        showToast('profile.json copied to clipboard');
      } catch {
        showToast('Failed to copy to clipboard', true);
      }
    }

    function isPlaceholder(val) {
      if (!val) return true;
      const s = String(val).trim().toLowerCase();
      const placeholders = [
        'username',
        'yourhandle',
        'your-handle',
        'your_handle',
        'user',
        'example',
        'author',
        'your name',
        'yourname',
        'your-name',
      ];
      return placeholders.includes(s);
    }

    function extractGitHubUsername(p) {
      if (!p) return '';
      // 1. From githubUrl
      const gh = (p.githubUrl || '').trim();
      if (gh) {
        const match = gh.match(/(?:https?:\/\/)?(?:www\.)?github\.com\/([a-zA-Z0-9_\-\.]+)/i);
        if (match && match[1] && !isPlaceholder(match[1])) {
          return match[1].replace(/\.git$/i, '').replace(/\/+$/, '');
        }
        if (!gh.includes('/') && !gh.includes(':') && !isPlaceholder(gh)) {
          return gh.replace(/^@/, '');
        }
      }
      // 2. From handle
      const handle = (p.handle || '').trim().replace(/^@/, '');
      if (handle && !isPlaceholder(handle)) {
        return handle;
      }
      // 3. From siteUrl (e.g. username.github.io)
      const site = (p.siteUrl || '').trim();
      if (site) {
        const ghIoMatch = site.match(/(?:https?:\/\/)?([a-zA-Z0-9_\-\.]+)\.github\.io/i);
        if (ghIoMatch && ghIoMatch[1] && !isPlaceholder(ghIoMatch[1])) {
          return ghIoMatch[1];
        }
      }
      return '';
    }

    function checkProfileStatus(p) {
      const username = extractGitHubUsername(p);
      const author = (p?.author || '').trim();
      const authorIsPlaceholder = !author || isPlaceholder(author);
      const ghIsPlaceholder = !p?.githubUrl || p.githubUrl.toLowerCase().includes('github.com/username') || p.githubUrl.toLowerCase().includes('example.com');
      const isIncomplete = !username || isPlaceholder(username) || authorIsPlaceholder || ghIsPlaceholder;

      return {
        isIncomplete,
        username: username || '',
      };
    }

    function extractRepoName(currentRemoteUrl, siteUrl) {
      if (currentRemoteUrl) {
        const clean = currentRemoteUrl.trim().replace(/\.git$/i, '').replace(/\/+$/, '');
        const parts = clean.split(/[\/:]/);
        const last = parts[parts.length - 1];
        if (last && last.length > 0) {
          return last;
        }
      }
      if (siteUrl) {
        try {
          const u = new URL(/^https?:\/\//i.test(siteUrl) ? siteUrl : `https://${siteUrl}`);
          const segs = u.pathname.split('/').filter(Boolean);
          if (segs.length > 0) {
            return segs[0];
          }
        } catch {}
      }
      return 'glyph.sh';
    }

    let currentGitInfo = {
      branch: 'master',
      remote: '',
      changedFiles: [],
      unpushedCommits: 0,
      isClean: true,
      lastCommit: '',
    };

    function updateGitCommandPreview() {
      const msgInput = document.getElementById('git-commit-msg-input');
      const previewEl = document.getElementById('git-cmd-preview');
      const branchSelect = document.getElementById('git-push-branch-select');
      const repoInput = document.getElementById('git-push-repo-input');
      if (!previewEl) return;

      const profileStatus = checkProfileStatus(profile);
      if (profileStatus.isIncomplete) {
        previewEl.textContent = '# Fill the profile details first to proceed github push.\n# Click "$ edit-profile" to set your author details and GitHub username.';
        return;
      }

      const branch = (branchSelect?.value || currentGitInfo.branch || 'master').toLowerCase();
      const defaultRepoName = extractRepoName(currentGitInfo.remote, profile.siteUrl);
      const repo = (repoInput?.value.trim()) || `https://github.com/${profileStatus.username}/${defaultRepoName}.git`;
      const rawMsg = msgInput ? msgInput.value.trim() : '';
      const commitPart = rawMsg
        ? `git commit -m "${rawMsg.replace(/"/g, '\\"')}"`
        : `git commit --allow-empty-message -m ""`;

      previewEl.textContent = `git remote set-url origin ${repo} && git branch -M ${branch} && git add -A && ${commitPart} && git push -u origin ${branch}`;
    }

    async function fetchGitStatus() {
      if (!isDev) return;
      const branchSelect = document.getElementById('git-push-branch-select');
      const repoInput = document.getElementById('git-push-repo-input');
      const repoBadge = document.getElementById('git-repo-badge');
      const repoHint = document.getElementById('git-repo-hint');
      const profileWarning = document.getElementById('git-profile-warning');
      const dotEl = document.getElementById('git-push-status-dot');
      const textEl = document.getElementById('git-push-status-text');
      const changedFilesBox = document.getElementById('git-changed-files-box');
      const changedFilesList = document.getElementById('git-changed-files-list');
      const changedFilesCount = document.getElementById('git-changed-files-count');
      const repoLink = document.getElementById('git-view-repo-link');
      const executeBtn = document.getElementById('execute-git-push-btn');
      const footerStatusText = document.getElementById('git-footer-status-text');
      const consoleOut = document.getElementById('git-console-output');

      if (textEl) textEl.textContent = 'Checking repository & profile...';
      if (dotEl) {
        dotEl.className = 'w-2 h-2 rounded-full bg-outline inline-block animate-pulse';
      }

      // 1. Sync latest profile.json from server
      try {
        const pRes = await fetch('/api/get-profile');
        if (pRes.ok) {
          const pData = await pRes.json();
          if (pData.profile) {
            profile = { ...profile, ...pData.profile };
          }
        }
      } catch {}

      // 2. Check profile completion status
      const profileStatus = checkProfileStatus(profile);

      // 3. Fetch git status from server
      try {
        const res = await fetch('/api/git-status');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed to query git status');

        currentGitInfo = data;

        // Set branch dropdown if not manually set by user yet
        if (branchSelect && data.branch) {
          const currentB = data.branch.toLowerCase();
          if (currentB === 'main' || currentB === 'master') {
            branchSelect.value = currentB;
          }
        }

        // Determine repo target
        const repoName = extractRepoName(data.remote, profile.siteUrl);
        const resolvedRepo = profileStatus.username
          ? `https://github.com/${profileStatus.username}/${repoName}.git`
          : (data.remote || `https://github.com/username/${repoName}.git`);

        if (repoInput) {
          repoInput.value = resolvedRepo;
        }

        if (repoBadge) {
          if (profileStatus.username) {
            repoBadge.textContent = `auto-filled from profile.json (@${profileStatus.username})`;
            repoBadge.className = 'text-primary text-[10px] font-mono px-1.5 py-0.2 bg-primary/10 border border-primary/30 rounded-[2px]';
          } else {
            repoBadge.textContent = 'profile details required';
            repoBadge.className = 'text-error text-[10px] font-mono px-1.5 py-0.2 bg-error/10 border border-error/30 rounded-[2px]';
          }
        }

        if (repoHint) {
          if (profileStatus.username) {
            repoHint.textContent = `Target repo: https://github.com/${profileStatus.username}/${repoName}.git (fetched from profile.json)`;
            repoHint.className = 'text-[10px] text-outline';
          } else {
            repoHint.textContent = '⚠️ GitHub username not found in profile.json. Fill profile details first.';
            repoHint.className = 'text-[10px] text-error font-medium';
          }
        }

        if (repoLink && profileStatus.username) {
          repoLink.href = `https://github.com/${profileStatus.username}/${repoName}`;
          repoLink.classList.remove('hidden');
          repoLink.classList.add('flex');
        } else if (repoLink) {
          repoLink.classList.add('hidden');
          repoLink.classList.remove('flex');
        }

        // Handle profile incomplete state vs complete state
        if (profileStatus.isIncomplete) {
          if (profileWarning) {
            profileWarning.classList.remove('hidden');
            profileWarning.classList.add('flex');
          }
          if (executeBtn) {
            executeBtn.disabled = true;
            executeBtn.title = 'Fill the profile details first to proceed github push';
            executeBtn.classList.add('opacity-50', 'cursor-not-allowed');
          }
          if (footerStatusText) {
            footerStatusText.textContent = 'Action disabled: profile details required';
            footerStatusText.className = 'text-error';
          }
          if (consoleOut) {
            consoleOut.textContent = [
              `⚠️ [PROFILE INCOMPLETE] Fill the profile details first to proceed github push.`,
              `----------------------------------------------------`,
              `Your profile in profile.json still contains template placeholder values:`,
              `  • Author: "${profile.author || 'N/A'}"`,
              `  • GitHub URL: "${profile.githubUrl || 'N/A'}"`,
              ``,
              `Click "$ edit-profile" above to set your real author name and GitHub username.`,
              `Once saved, your GitHub repository URL will be automatically configured here.`,
            ].join('\n');
          }
        } else {
          if (profileWarning) {
            profileWarning.classList.add('hidden');
            profileWarning.classList.remove('flex');
          }
          if (executeBtn) {
            executeBtn.disabled = false;
            executeBtn.title = 'Push local codebase to GitHub';
            executeBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          }
          if (footerStatusText) {
            footerStatusText.textContent = `Ready to push to @${profileStatus.username}/${repoName}`;
            footerStatusText.className = 'text-outline';
          }
        }

        const changesCount = (data.changedFiles || []).length;
        if (changesCount > 0) {
          if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-primary inline-block';
          if (textEl) textEl.textContent = `${changesCount} pending file(s) to commit`;

          if (changedFilesBox && changedFilesList) {
            changedFilesBox.classList.remove('hidden');
            if (changedFilesCount) changedFilesCount.textContent = `${changesCount} file(s)`;
            changedFilesList.innerHTML = data.changedFiles
              .map((line) => {
                const parts = line.split(/\s+/);
                const code = parts[0] || 'M';
                const file = parts.slice(1).join(' ') || line;
                let colorClass = 'text-primary';
                if (code.includes('D')) colorClass = 'text-error';
                else if (code.includes('?')) colorClass = 'text-outline';
                return `<div class="flex items-center justify-between text-[10px]"><span class="truncate font-mono">${file}</span><span class="${colorClass} font-bold font-mono shrink-0 ml-2">${code}</span></div>`;
              })
              .join('');
          }
        } else {
          if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-outline inline-block';
          const unpushed = data.unpushedCommits || 0;
          if (textEl) {
            textEl.textContent = unpushed > 0
              ? `Working tree clean (${unpushed} unpushed commit${unpushed > 1 ? 's' : ''})`
              : 'Working tree clean, ready';
          }
          if (changedFilesBox) changedFilesBox.classList.add('hidden');
        }

        updateGitCommandPreview();
      } catch (err) {
        if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-error inline-block';
        if (textEl) textEl.textContent = `Status check failed: ${err.message}`;
      }
    }

    function openGitPushModal() {
      if (!isDev) return;
      const modal = document.getElementById('git-push-modal');
      if (modal) {
        modal.style.display = 'flex';
        modal.classList.remove('hidden');
      }
      fetchGitStatus();
      const consoleOut = document.getElementById('git-console-output');
      if (consoleOut) {
        consoleOut.textContent = 'Ready to push local codebase to GitHub.\nClick "Push to GitHub" to proceed or run the terminal command shown above.';
      }
      const consoleStatus = document.getElementById('git-console-status');
      if (consoleStatus) {
        consoleStatus.textContent = 'Ready';
        consoleStatus.className = 'text-[10px] text-outline';
      }
    }

    function closeGitPushModal() {
      const modal = document.getElementById('git-push-modal');
      if (modal) {
        modal.style.display = 'none';
        modal.classList.add('hidden');
      }
    }

    async function executeGitPush() {
      if (!isDev) return;

      const profileStatus = checkProfileStatus(profile);
      if (profileStatus.isIncomplete) {
        showToast('Fill the profile details first to proceed github push', true);
        return;
      }

      const btn = document.getElementById('execute-git-push-btn');
      const icon = document.getElementById('git-push-btn-icon');
      const text = document.getElementById('git-push-btn-text');
      const consoleOut = document.getElementById('git-console-output');
      const consoleStatus = document.getElementById('git-console-status');
      const msgInput = document.getElementById('git-commit-msg-input');
      const branchSelect = document.getElementById('git-push-branch-select');
      const repoInput = document.getElementById('git-push-repo-input');

      const commitMsg = msgInput ? msgInput.value.trim() : '';
      const selectedBranch = (branchSelect?.value || currentGitInfo.branch || 'master').toLowerCase();
      const repoUrl = repoInput?.value.trim() || '';

      if (btn) btn.disabled = true;
      if (icon) icon.textContent = '⏳';
      if (text) text.textContent = 'Pushing to GitHub...';
      if (consoleStatus) {
        consoleStatus.textContent = 'Pushing...';
        consoleStatus.className = 'text-[10px] text-primary animate-pulse';
      }

      if (consoleOut) {
        consoleOut.textContent = [
          `> git remote set-url origin ${repoUrl}`,
          `> git branch -M ${selectedBranch}`,
          `> git add -A`,
          `> git commit ${commitMsg ? `-m "${commitMsg}"` : '--allow-empty-message -m ""'}`,
          `> git push -u origin ${selectedBranch}`,
          ``,
          `Pushing codebase to ${repoUrl} [branch: ${selectedBranch}]... Please wait.`,
        ].join('\n');
      }

      try {
        const res = await fetch('/api/git-push', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: commitMsg,
            branch: selectedBranch,
            repoUrl: repoUrl,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (consoleStatus) {
            consoleStatus.textContent = 'Success';
            consoleStatus.className = 'text-[10px] text-primary font-bold';
          }
          if (consoleOut) {
            consoleOut.textContent = [
              `✔ [SUCCESS] Codebase pushed to origin/${data.branch || selectedBranch}!`,
              `Target Remote: ${data.remote || repoUrl}`,
              `----------------------------------------------------`,
              data.hasNewCommit ? `Commit Output:\n${data.commitOutput}` : `Commit: Working tree clean`,
              `----------------------------------------------------`,
              `Push Output:\n${data.pushOutput || 'Everything up-to-date'}`,
              `----------------------------------------------------`,
              `Latest commit: ${data.lastCommit || 'N/A'}`,
              `GitHub Pages deployment action triggered automatically.`,
            ].join('\n');
          }
          if (icon) icon.textContent = '✔';
          if (text) text.textContent = 'Pushed Successfully!';
          showToast('✔ Codebase pushed to GitHub successfully!');
          if (msgInput) msgInput.value = '';

          // Refresh status after 2.5s
          setTimeout(() => {
            fetchGitStatus();
            if (btn) btn.disabled = false;
            if (icon) icon.textContent = '↑';
            if (text) text.textContent = 'Push to GitHub';
          }, 2500);
        } else {
          throw new Error(data.error || data.message || 'Push failed');
        }
      } catch (err) {
        if (consoleStatus) {
          consoleStatus.textContent = 'Failed';
          consoleStatus.className = 'text-[10px] text-error font-bold';
        }
        if (consoleOut) {
          const previewEl = document.getElementById('git-cmd-preview');
          const cmd = previewEl ? previewEl.textContent : `git push -u origin ${selectedBranch}`;
          consoleOut.textContent = [
            `✖ [ERROR] Failed to push to remote:`,
            err.message,
            `----------------------------------------------------`,
            `If your git remote requires interactive authentication (SSH passphrase, browser login, or token), run this command directly in your terminal:`,
            ``,
            `  ${cmd}`,
          ].join('\n');
        }
        if (btn) btn.disabled = false;
        if (icon) icon.textContent = '↑';
        if (text) text.textContent = 'Retry Push';
        showToast('Push failed. Check console output.', true);
      }
    }

    async function copyGitCommand() {
      const previewEl = document.getElementById('git-cmd-preview');
      const copyTextEl = document.getElementById('copy-git-cmd-text');
      if (!previewEl) return;
      try {
        await navigator.clipboard.writeText(previewEl.textContent || '');
        if (copyTextEl) {
          copyTextEl.textContent = 'Copied!';
          setTimeout(() => { copyTextEl.textContent = 'Copy Command'; }, 2000);
        }
        showToast('Command copied to clipboard');
      } catch {
        showToast('Failed to copy to clipboard', true);
      }
    }

    function initProfileEditor() {
      updateAccessUI();
      if (!isDev) return;
      applyProfile(currentProfile);

      const editBtn = document.getElementById('edit-profile-btn');
      if (editBtn) editBtn.onclick = openEditorModal;

      const exportBtn = document.getElementById('export-config-btn');
      if (exportBtn) exportBtn.onclick = openExportModal;

      const closeEditorBtn = document.getElementById('close-editor-btn');
      if (closeEditorBtn) closeEditorBtn.onclick = closeEditorModal;

      const cancelEditorBtn = document.getElementById('cancel-editor-btn');
      if (cancelEditorBtn) cancelEditorBtn.onclick = closeEditorModal;

      const closeExportBtn = document.getElementById('close-export-btn');
      if (closeExportBtn) closeExportBtn.onclick = closeExportModal;

      const closeExportBtn2 = document.getElementById('close-export-btn-2');
      if (closeExportBtn2) closeExportBtn2.onclick = closeExportModal;

      const gitPushBtn = document.getElementById('git-push-btn');
      if (gitPushBtn) gitPushBtn.onclick = openGitPushModal;

      const closeGitPushBtn = document.getElementById('close-git-push-btn');
      if (closeGitPushBtn) closeGitPushBtn.onclick = closeGitPushModal;

      const closeGitPushBtn2 = document.getElementById('close-git-push-btn-2');
      if (closeGitPushBtn2) closeGitPushBtn2.onclick = closeGitPushModal;

      const gitRefreshBtn = document.getElementById('git-refresh-status-btn');
      if (gitRefreshBtn) gitRefreshBtn.onclick = fetchGitStatus;

      const executeGitPushBtn = document.getElementById('execute-git-push-btn');
      if (executeGitPushBtn) executeGitPushBtn.onclick = executeGitPush;

      const copyGitCmdBtn = document.getElementById('copy-git-cmd-btn');
      if (copyGitCmdBtn) copyGitCmdBtn.onclick = copyGitCommand;

      const gitCommitMsgInput = document.getElementById('git-commit-msg-input');
      if (gitCommitMsgInput) gitCommitMsgInput.oninput = updateGitCommandPreview;

      const branchSelect = document.getElementById('git-push-branch-select');
      if (branchSelect) branchSelect.onchange = updateGitCommandPreview;

      const repoInput = document.getElementById('git-push-repo-input');
      if (repoInput) repoInput.oninput = updateGitCommandPreview;

      const openProfileBtn = document.getElementById('git-open-profile-btn');
      if (openProfileBtn) {
        openProfileBtn.onclick = () => {
          closeGitPushModal();
          openEditorModal();
        };
      }

      const copyExportBtn = document.getElementById('copy-export-code-btn');
      if (copyExportBtn) {
        copyExportBtn.onclick = async () => {
          await copyJson();
          const text = document.getElementById('copy-export-text');
          if (text) {
            text.textContent = 'Copied!';
            setTimeout(() => { text.textContent = 'Copy JSON'; }, 2000);
          }
        };
      }

      const downloadJsonBtn = document.getElementById('prof-download-json-btn');
      if (downloadJsonBtn) downloadJsonBtn.onclick = downloadJson;

      const form = document.getElementById('profile-editor-form');
      if (form) form.onsubmit = handleSave;

      // Direct on-page logo upload triggers
      const directUploadBtn = document.getElementById('logo-upload-overlay-btn');
      const directFileInput = document.getElementById('direct-logo-file-input');
      if (directUploadBtn && directFileInput) {
        directUploadBtn.onclick = () => {
          if (!isDev) return;
          directFileInput.click();
        };
        directFileInput.onchange = (e) => {
          const file = e.target.files?.[0];
          if (file) {
            uploadLogoFile(file);
            directFileInput.value = '';
          }
        };
      }

      // Modal logo upload & removal triggers
      const modalUploadBtn = document.getElementById('modal-upload-logo-btn');
      const modalFileInput = document.getElementById('modal-logo-file-input');
      const modalRemoveBtn = document.getElementById('modal-remove-logo-btn');
      if (modalUploadBtn && modalFileInput) {
        modalUploadBtn.onclick = () => {
          if (!isDev) return;
          modalFileInput.click();
        };
        modalFileInput.onchange = (e) => {
          const file = e.target.files?.[0];
          if (file) {
            uploadLogoFile(file);
            modalFileInput.value = '';
          }
        };
      }
      if (modalRemoveBtn) {
        modalRemoveBtn.onclick = removeLogo;
      }

      const bioInp = document.getElementById('prof-description');
      if (bioInp) {
        bioInp.oninput = () => {
          const countEl = document.getElementById('prof-bio-count');
          if (countEl) countEl.textContent = `${bioInp.value.length} chars`;
        };
      }

      document.onkeydown = (e) => {
        const isInput = ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName || '');

        if (e.key === 'e' && !isInput && !e.ctrlKey && !e.metaKey && !e.altKey) {
          if (!isDev) return;
          const modal = document.getElementById('profile-editor-modal');
          if (modal && modal.classList.contains('hidden')) {
            e.preventDefault();
            openEditorModal();
          }
        }

        if (e.key === 'Escape') {
          closeEditorModal();
          closeExportModal();
          closeGitPushModal();
        }

        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          const modal = document.getElementById('profile-editor-modal');
          if (modal && !modal.classList.contains('hidden')) {
            e.preventDefault();
            handleSave();
          }
        }
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProfileEditor);
    } else {
      initProfileEditor();
    }
    document.addEventListener('astro:page-load', initProfileEditor);
  })();
</script>
