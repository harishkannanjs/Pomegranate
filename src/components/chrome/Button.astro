---
interface Props {
  variant?: 'primary' | 'secondary' | 'danger';
  shortcut?: string;
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  disabled?: boolean;
}

const {
  variant = 'secondary',
  shortcut,
  href,
  class: className = '',
  type = 'button',
  id,
  disabled = false,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

{/* TUI Mode sub-template */}
<Tag
  id={id ? `${id}-tui` : undefined}
  href={href}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={[
    'chrome-tui-inline items-center gap-1.5 font-mono text-xs px-3 py-1.5 transition-colors select-none rounded-none',
    variant === 'primary' && 'border-2 border-read-accent text-read-accent hover:bg-read-accent-fill hover:text-[#FDF8F5] font-bold',
    variant === 'secondary' && 'border-2 border-read-border-strong text-read-text-primary hover:bg-read-bg-surface-raised hover:border-read-accent',
    variant === 'danger' && 'border-2 border-chrome-danger text-chrome-danger hover:bg-chrome-danger hover:text-white',
    disabled && 'opacity-40 cursor-not-allowed pointer-events-none',
    className,
  ]}
  {...rest}
>
  <span class="text-read-text-tertiary">[</span>
  <slot />
  {shortcut && <span class="text-read-text-tertiary ml-1.5 font-normal">{shortcut}</span>}
  <span class="text-read-text-tertiary">]</span>
</Tag>

{/* Standard Mode sub-template */}
<Tag
  id={id ? `${id}-std` : undefined}
  href={href}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={[
    'chrome-std-inline items-center justify-center gap-2 text-xs font-medium px-4 py-2 rounded-lg transition-all select-none',
    variant === 'primary' && 'bg-read-accent text-white hover:opacity-90 shadow-sm',
    variant === 'secondary' && 'bg-read-bg-surface-raised text-read-text-primary border border-read-border hover:border-read-border-strong shadow-sm',
    variant === 'danger' && 'bg-chrome-danger text-white hover:opacity-90 shadow-sm',
    disabled && 'opacity-40 cursor-not-allowed pointer-events-none',
    className,
  ]}
  {...rest}
>
  <slot />
  {shortcut && (
    <kbd
      class:list={[
        'ml-1.5 px-1.5 py-0.5 text-[10px] uppercase font-mono rounded select-none transition-colors',
        variant === 'primary' || variant === 'danger'
          ? 'bg-black/30 text-white border border-white/20'
          : 'bg-read-bg-base/40 text-read-text-secondary border border-read-border',
      ]}
    >
      {shortcut}
    </kbd>
  )}
</Tag>
