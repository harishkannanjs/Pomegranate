---
interface Props {
  type?: astroHTML.JSX.HTMLInputTypeAttribute;
  placeholder?: string;
  value?: string;
  id?: string;
  name?: string;
  disabled?: boolean;
  prompt?: string;
  class?: string;
  required?: boolean;
}

const {
  type = 'text',
  placeholder = '',
  value = '',
  id,
  name,
  disabled = false,
  prompt = '$',
  class: className = '',
  required = false,
  ...rest
} = Astro.props;
---

{/* TUI Mode sub-template: Prompt-styled field */}
<div
  class:list={[
    'chrome-tui-inline items-center border border-read-border-strong bg-read-bg-base px-3 py-2 font-mono text-xs focus-within:border-read-accent focus-within:ring-1 focus-within:ring-read-accent rounded-none transition-colors w-full',
    disabled && 'opacity-40 cursor-not-allowed',
    className,
  ]}
>
  <span class="text-read-accent mr-2 font-bold select-none">{prompt}</span>
  <input
    type={type}
    id={id ? `${id}-tui` : undefined}
    name={name}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    class="bg-transparent text-read-text-primary placeholder:text-read-text-tertiary focus:outline-none w-full font-mono text-xs"
    {...rest}
  />
  <span class="text-read-accent animate-pulse font-bold select-none">_</span>
</div>

{/* Standard Mode sub-template: Modern rounded input */}
<div class:list={['chrome-std-block w-full', className]}>
  <input
    type={type}
    id={id ? `${id}-std` : undefined}
    name={name}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    class:list={[
      'w-full rounded-lg border border-read-border bg-chrome-input-bg text-read-text-primary placeholder:text-read-text-tertiary px-3.5 py-2 text-sm focus:border-read-accent focus:ring-2 focus:ring-read-accent/20 focus:outline-none transition-all',
      disabled && 'opacity-40 cursor-not-allowed',
    ]}
    {...rest}
  />
</div>
