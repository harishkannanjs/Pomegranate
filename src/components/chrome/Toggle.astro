---
interface Props {
  id?: string;
  name?: string;
  checked?: boolean;
  disabled?: boolean;
  label?: string;
  class?: string;
}

const {
  id = `toggle-${Math.random().toString(36).slice(2, 9)}`,
  name,
  checked = false,
  disabled = false,
  label,
  class: className = '',
} = Astro.props;
---

<label class:list={['inline-flex items-center gap-3 cursor-pointer select-none', disabled && 'opacity-40 cursor-not-allowed pointer-events-none', className]}>
  <input
    type="checkbox"
    id={id}
    name={name}
    checked={checked}
    disabled={disabled}
    class="peer sr-only"
  />

  {/* TUI Mode sub-template: [ Y ] / [ N ] */}
  <span class="chrome-tui-inline items-center gap-1.5 font-mono text-xs font-bold">
    <span class="peer-checked:hidden px-2 py-0.5 rounded-[3px] border border-read-border-strong text-read-text-tertiary bg-read-bg-surface">
      [ N ]
    </span>
    <span class="hidden peer-checked:inline-block px-2 py-0.5 rounded-[3px] bg-read-accent text-read-bg-base border border-read-accent">
      [ Y ]
    </span>
    {label && <span class="text-read-text-primary text-xs ml-1">{label}</span>}
  </span>

  {/* Standard Mode sub-template: Sliding Pill */}
  <span class="chrome-std-inline items-center gap-2.5">
    <span class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-read-border transition-colors duration-200 ease-in-out peer-checked:bg-read-accent">
      <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-0 peer-checked:translate-x-5"></span>
    </span>
    {label && <span class="text-read-text-primary text-sm font-medium">{label}</span>}
  </span>
</label>
