<script>
  // Real multi-format conversion pipeline dispatcher (Phase 5)
  async function convertToMarkdown(file: File): Promise<{ content: string; filename: string; warning?: string }> {
    const name = file.name || 'untitled.md';
    const ext = name.split('.').pop()?.toLowerCase() || '';

    // Fast-path: local text passthrough for plain text and markdown
    if (['md', 'mdx', 'markdown', 'txt'].includes(ext)) {
      const text = await file.text();
      return { content: text, filename: name };
    }

    const audioExtensions = ['mp3', 'wav', 'm4a', 'ogg', 'flac', 'aac'];
    const isAudio = audioExtensions.includes(ext);

    let groqApiKey = '';
    if (isAudio) {
      groqApiKey = localStorage.getItem('pomegranate_groq_api_key') || '';
      if (!groqApiKey.trim()) {
        const legacyKey = localStorage.getItem('blogly_groq_api_key') || '';
        if (legacyKey.trim()) {
          groqApiKey = legacyKey;
          try {
            localStorage.setItem('pomegranate_groq_api_key', legacyKey);
            localStorage.removeItem('blogly_groq_api_key');
          } catch {}
        }
      }
      if (!groqApiKey.trim()) {
        const goToSettings = confirm(
          'Add a Groq API key in Settings to convert audio files.\n\nWould you like to open Settings now to add your Groq API key?'
        );
        if (goToSettings) {
          const settingsBtn = document.querySelector('[data-tab-id="settings"]') as HTMLElement | null;
          if (settingsBtn) settingsBtn.click();
        }
        throw new Error('Add a Groq API key in Settings to convert audio files');
      }

      // Explicit consent prompt before audio leaves device per SPEC.md
      const consent = confirm('This file will be sent to Groq to convert it — continue?');
      if (!consent) {
        throw new Error('Audio conversion cancelled by user (no data was sent).');
      }

      // Stream file directly from browser to Groq's official API: zero key leakage to any server
      const formData = new FormData();
      formData.append('file', file, name);
      formData.append('model', 'whisper-large-v3');
      formData.append('response_format', 'verbose_json');

      const response = await fetch('https://api.groq.com/openai/v1/audio/transcriptions', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${groqApiKey.trim()}`,
        },
        body: formData,
      });

      if (!response.ok) {
        const errorBody = await response.text();
        let errMsg = `Groq Whisper transcription failed (${response.status})`;
        try {
          const parsed = JSON.parse(errorBody);
          if (parsed.error?.message) {
            errMsg = `Groq API Error: ${parsed.error.message}`;
          }
        } catch {}
        throw new Error(errMsg);
      }

      const groqData = await response.json();
      const text = (groqData.text || '').trim();
      const baseName = name.replace(/\.[^/.]+$/, '');
      const derivedTitle = baseName
        .replace(/^[0-9]+[-_]?/, '')
        .split(/[-_]+/)
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(' ') || 'Untitled Article';

      let markdown = `# ${derivedTitle}\n\n`;
      if (text) {
        markdown += text.split(/\r?\n\s*\r?\n+/).map((p: string) => p.trim()).filter(Boolean).join('\n\n');
      } else {
        markdown += `> *Audio transcription completed for ${name}: No speech detected.*`;
      }

      return {
        content: markdown,
        filename: `${baseName}.md`,
      };
    }

    // Convert file to Base64 data URL for local Tier 1 conversion
    const fileBase64 = await new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result as string);
      reader.onerror = () => reject(new Error('Failed to read file into memory'));
      reader.readAsDataURL(file);
    });

    let res: Response;
    try {
      res = await fetch('/api/convert-file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          filename: file.name,
          fileBase64,
          mimeType: file.type,
        }),
      });
    } catch {
      throw new Error(
        'Local conversion server unreachable. The multi-format file pipeline runs in your local Pomegranate author environment (`bun run dev`). Direct Markdown (.md/.mdx) editing is active.'
      );
    }

    if (res.status === 404) {
      throw new Error(
        'Conversion endpoint unavailable on static deployment. The multi-format pipeline runs in your local author environment (`bun run dev`).'
      );
    }

    const data = await res.json();
    if (!res.ok || !data.success) {
      throw new Error(data.error || 'Conversion failed');
    }

    return {
      content: data.markdown,
      filename: data.filename || `${name.replace(/\.[^/.]+$/, '')}.md`,
      warning: data.warning,
    };
  }

  // Lightweight client-side Markdown to HTML renderer for split editor
  function renderMarkdownToHtml(markdown: string): string {
    if (!markdown || !markdown.trim()) {
      return '<p class="text-read-text-tertiary italic font-mono text-xs">Preview will appear here as you type...</p>';
    }

    // Strip frontmatter if present
    let content = markdown;
    if (content.startsWith('---')) {
      const endFm = content.indexOf('---', 3);
      if (endFm !== -1) {
        content = content.slice(endFm + 3).trim();
      }
    }

    // Escape raw HTML entities
    const escapeHtml = (str: string) =>
      str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');

    // Handle code blocks first to protect code content
    const codeBlocks: string[] = [];
    content = content.replace(/```([a-zA-Z0-9_-]*)\r?\n([\s\S]*?)```/g, (_, lang, code) => {
      const idx = codeBlocks.length;
      const langBadge = lang ? `<span class="text-xs text-read-accent font-mono block pb-1 border-b border-read-border mb-2">${escapeHtml(lang)}</span>` : '';
      codeBlocks.push(
        `<pre class="bg-read-bg-base border border-read-border p-3.5 my-3 rounded-[2px] overflow-x-auto text-xs font-mono">${langBadge}<code>${escapeHtml(code.trim())}</code></pre>`
      );
      return `__CODE_BLOCK_${idx}__`;
    });

    // Handle inline code to protect inline code content
    const inlineCodes: string[] = [];
    content = content.replace(/`([^`]+)`/g, (_, code) => {
      const idx = inlineCodes.length;
      inlineCodes.push(`<code class="px-1.5 py-0.5 bg-read-bg-base border border-read-border rounded-[2px] text-read-accent font-mono text-xs">${escapeHtml(code)}</code>`);
      return `__INLINE_CODE_${idx}__`;
    });

    // Escape all raw HTML characters in the remaining markdown text
    content = escapeHtml(content);

    // Sanitize URL helper
    const cleanUrl = (url: string) => {
      const trimmed = url.trim();
      if (/^javascript:/i.test(trimmed) || /^vbscript:/i.test(trimmed)) return '#';
      return trimmed;
    };

    // Headers
    content = content.replace(/^######\s+(.+)$/gm, '<h6 class="text-sm font-bold text-read-text-primary mt-4 mb-2">$1</h6>');
    content = content.replace(/^#####\s+(.+)$/gm, '<h5 class="text-sm font-bold text-read-text-primary mt-4 mb-2">$1</h5>');
    content = content.replace(/^####\s+(.+)$/gm, '<h4 class="text-base font-bold text-read-text-primary mt-4 mb-2">$1</h4>');
    content = content.replace(/^###\s+(.+)$/gm, '<h3 class="text-lg font-bold text-read-text-primary mt-5 mb-2">$1</h3>');
    content = content.replace(/^##\s+(.+)$/gm, '<h2 class="text-xl font-bold text-read-text-primary mt-6 mb-3 pb-1 border-b border-read-border">$1</h2>');
    content = content.replace(/^#\s+(.+)$/gm, '<h1 class="text-2xl font-bold text-read-text-primary mt-6 mb-3 pb-2 border-b border-read-border">$1</h1>');

    // Blockquotes
    content = content.replace(/^&gt;\s+(.+)$/gm, '<blockquote class="border-l-2 border-read-accent pl-3.5 my-2.5 text-read-text-secondary italic font-mono text-xs">$1</blockquote>');

    // Horizontal Rule
    content = content.replace(/^---$/gm, '<hr class="border-t border-read-border my-5" />');

    // Bold & Italics
    content = content.replace(/\*\*([^*]+)\*\*/g, '<strong class="font-bold text-read-text-primary">$1</strong>');
    content = content.replace(/\*([^*]+)\*/g, '<em class="italic">$1</em>');
    content = content.replace(/~~([^~]+)~~/g, '<del class="line-through text-read-text-tertiary">$1</del>');

    // Links & Images
    content = content.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_, alt, url) => `<img src="${cleanUrl(url)}" alt="${alt}" class="max-w-full my-3 rounded-[2px] border border-read-border" />`);
    content = content.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, text, url) => `<a href="${cleanUrl(url)}" target="_blank" rel="noopener" class="text-read-accent underline underline-offset-4 hover:opacity-80">${text}</a>`);

    // Lists
    content = content.replace(/^\s*[-*]\s+(.+)$/gm, '<li class="ml-4 list-disc text-read-text-primary">$1</li>');
    content = content.replace(/^\s*(\d+)\.\s+(.+)$/gm, '<li class="ml-4 list-decimal text-read-text-primary">$2</li>');

    // Markdown tables
    content = content.replace(/(?:^|\n)(\|.+?\|\r?\n\|[-:\s|]+?\|\r?\n(?:\|.+?\|\r?\n?)+)/g, (match) => {
      const lines = match.trim().split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
      if (lines.length < 2) return match;
      const parseRow = (line: string) =>
        line
          .replace(/^\||\|$/g, '')
          .split('|')
          .map((c) => c.trim());

      const headers = parseRow(lines[0]);
      const dataRows = lines.slice(2).map(parseRow);

      const thead = `<thead><tr class="border-b border-read-border bg-read-bg-surface-raised">${headers.map((h) => `<th class="px-3 py-1.5 text-left text-xs font-bold text-read-text-primary border border-read-border">${h}</th>`).join('')}</tr></thead>`;
      const tbody = `<tbody>${dataRows.map((row) => `<tr class="border-b border-read-border/50 hover:bg-read-bg-surface/50">${headers.map((_, i) => `<td class="px-3 py-1.5 text-xs text-read-text-secondary border border-read-border">${row[i] || ''}</td>`).join('')}</tr>`).join('')}</tbody>`;

      return `\n<div class="my-4 overflow-x-auto border border-read-border rounded-[2px]"><table class="w-full text-xs font-mono border-collapse bg-read-bg-base">${thead}${tbody}</table></div>\n`;
    });

    // Paragraphs: split by double newlines
    const paragraphs = content.split(/\n\n+/);
    const htmlParts = paragraphs.map((para) => {
      para = para.trim();
      if (!para) return '';
      if (
        para.startsWith('<h') ||
        para.startsWith('<blockquote') ||
        para.startsWith('<hr') ||
        para.startsWith('<li') ||
        para.startsWith('<div class="my-4 overflow-x-auto') ||
        para.startsWith('__CODE_BLOCK_')
      ) {
        return para;
      }
      return `<p class="my-2.5 text-read-text-primary leading-relaxed">${para.replace(/\n/g, '<br/>')}</p>`;
    });

    let rendered = htmlParts.join('\n');
    // Restore inline code
    inlineCodes.forEach((ic, idx) => {
      rendered = rendered.replace(`__INLINE_CODE_${idx}__`, ic);
    });
    // Restore code blocks
    codeBlocks.forEach((block, idx) => {
      rendered = rendered.replace(`__CODE_BLOCK_${idx}__`, block);
    });

    return rendered;
  }

  function initFileUploadTab() {
    const rawInput = document.getElementById('raw-markdown-input') as HTMLTextAreaElement | null;
    const renderedOutput = document.getElementById('rendered-markdown-output');
    const statsEl = document.getElementById('editor-stats');
    const dirtyIndicator = document.getElementById('editor-dirty-indicator');
    const dropzone = document.getElementById('file-dropzone');
    const filePicker = document.getElementById('file-picker-input') as HTMLInputElement | null;
    const alertBanner = document.getElementById('upload-alert-banner');
    const alertText = document.getElementById('upload-alert-text');
    const closeAlertBtn = document.getElementById('close-alert-btn');

    // Metadata inputs
    const titleInp = document.getElementById('meta-title') as HTMLInputElement | null;
    const filenameInp = document.getElementById('meta-filename') as HTMLInputElement | null;
    const tagsInp = document.getElementById('meta-tags') as HTMLInputElement | null;
    const dateInp = document.getElementById('meta-date') as HTMLInputElement | null;
    const descInp = document.getElementById('meta-desc') as HTMLInputElement | null;
    const seriesNameInp = document.getElementById('meta-series-name') as HTMLInputElement | null;
    const seriesPartInp = document.getElementById('meta-series-part') as HTMLInputElement | null;
    const seriesTotalInp = document.getElementById('meta-series-total') as HTMLInputElement | null;
    const targetPathDisplay = document.getElementById('target-path-display');
    const seriesMetadataBox = document.getElementById('series-metadata-box');
    const trackStandaloneBtn = document.getElementById('track-standalone-btn');
    const trackSeriesBtn = document.getElementById('track-series-btn');

    // Modals
    const livePreviewModal = document.getElementById('live-preview-modal');
    const gitPushModal = document.getElementById('git-push-modal');

    let currentTrack: 'standalone' | 'series' = 'standalone';

    function setAlert(message: string, isWarning = false) {
      if (!alertBanner || !alertText) return;
      alertBanner.classList.remove('hidden', 'bg-read-accent/10', 'border-read-accent', 'bg-amber-500/10', 'border-amber-500', 'bg-red-500/10', 'border-red-500');

      if (message.includes('Add a Groq API key in Settings')) {
        alertText.innerHTML = `<span>${message}</span> <button type="button" id="alert-settings-link" class="underline font-bold text-read-accent ml-2 hover:opacity-80 cursor-pointer">[Open Settings Tab]</button>`;
        const link = document.getElementById('alert-settings-link');
        if (link) {
          link.onclick = () => {
            const settingsBtn = document.querySelector('[data-tab-id="settings"]') as HTMLElement | null;
            if (settingsBtn) settingsBtn.click();
          };
        }
        alertBanner.classList.add('bg-amber-500/10', 'border-amber-500', 'text-amber-400');
      } else if (isWarning) {
        alertText.textContent = message;
        alertBanner.classList.add('bg-amber-500/10', 'border-amber-500', 'text-amber-400');
      } else {
        alertText.textContent = message;
        alertBanner.classList.add('bg-read-accent/10', 'border-read-accent', 'text-read-accent');
      }
    }

    if (closeAlertBtn) {
      closeAlertBtn.onclick = () => alertBanner?.classList.add('hidden');
    }

    // Default publish date to today
    if (dateInp && !dateInp.value) {
      dateInp.value = new Date().toISOString().split('T')[0];
    }

    function updateTargetPath() {
      if (!targetPathDisplay) return;
      const rawName = (filenameInp?.value || 'untitled.md').trim();
      const cleanName = rawName.endsWith('.md') || rawName.endsWith('.mdx') ? rawName : `${rawName}.md`;
      if (currentTrack === 'series') {
        const sName = (seriesNameInp?.value || 'series-track').trim().toLowerCase().replace(/[^a-z0-9_-]+/g, '-');
        targetPathDisplay.textContent = `Blogs/series/${sName}/${cleanName}`;
      } else {
        targetPathDisplay.textContent = `Blogs/standalone/${cleanName}`;
      }
    }

    // Track switcher
    if (trackStandaloneBtn && trackSeriesBtn && seriesMetadataBox) {
      trackStandaloneBtn.onclick = () => {
        currentTrack = 'standalone';
        trackStandaloneBtn.classList.add('bg-read-accent', 'text-read-bg-base', 'font-bold');
        trackStandaloneBtn.classList.remove('text-read-text-secondary');
        trackSeriesBtn.classList.remove('bg-read-accent', 'text-read-bg-base', 'font-bold');
        trackSeriesBtn.classList.add('text-read-text-secondary');
        seriesMetadataBox.classList.add('hidden');
        updateTargetPath();
      };

      trackSeriesBtn.onclick = () => {
        currentTrack = 'series';
        trackSeriesBtn.classList.add('bg-read-accent', 'text-read-bg-base', 'font-bold');
        trackSeriesBtn.classList.remove('text-read-text-secondary');
        trackStandaloneBtn.classList.remove('bg-read-accent', 'text-read-bg-base', 'font-bold');
        trackStandaloneBtn.classList.add('text-read-text-secondary');
        seriesMetadataBox.classList.remove('hidden');
        updateTargetPath();
      };
    }

    // Live split editor sync
    function updateLivePreview() {
      if (!rawInput || !renderedOutput) return;
      const text = rawInput.value;
      renderedOutput.innerHTML = renderMarkdownToHtml(text);

      // Calculate stats
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;
      const readMinutes = Math.ceil(words / 200) || 1;
      if (statsEl) {
        statsEl.textContent = `${words} words · ~${readMinutes} min read`;
      }
      if (dirtyIndicator) {
        dirtyIndicator.classList.remove('hidden');
      }
      updateTargetPath();
    }

    if (rawInput) {
      rawInput.addEventListener('input', updateLivePreview);
    }
    if (filenameInp) filenameInp.addEventListener('input', updateTargetPath);
    if (seriesNameInp) seriesNameInp.addEventListener('input', updateTargetPath);

    // Markdown quick formatting buttons
    document.querySelectorAll('[data-fmt]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!rawInput) return;
        const fmt = (btn as HTMLElement).dataset.fmt;
        const start = rawInput.selectionStart;
        const end = rawInput.selectionEnd;
        const val = rawInput.value;
        const selected = val.substring(start, end);
        let insert = '';

        switch (fmt) {
          case 'h1': insert = `# ${selected || 'Heading 1'}`; break;
          case 'h2': insert = `## ${selected || 'Heading 2'}`; break;
          case 'bold': insert = `**${selected || 'bold text'}**`; break;
          case 'italic': insert = `*${selected || 'italic text'}*`; break;
          case 'code': insert = `\`${selected || 'code'}\``; break;
          case 'quote': insert = `> ${selected || 'quote'}`; break;
          case 'list': insert = `- ${selected || 'list item'}`; break;
          case 'link': insert = `[${selected || 'link text'}](https://)`; break;
          default: break;
        }

        rawInput.value = val.substring(0, start) + insert + val.substring(end);
        rawInput.focus();
        updateLivePreview();
      });
    });

    // File loading and conversion dispatcher
    async function handleLoadedFile(file: File) {
      try {
        const ext = file.name.split('.').pop()?.toLowerCase() || '';
        const isAudio = ['mp3', 'wav', 'm4a', 'ogg', 'flac', 'aac'].includes(ext);
        const isOcr = ['png', 'jpg', 'jpeg', 'webp', 'bmp', 'tiff', 'gif'].includes(ext);

        if (isAudio) {
          setAlert(`Transcribing audio "${file.name}" via Groq Whisper Large V3...`);
        } else if (isOcr) {
          setAlert(`Extracting text from image "${file.name}" via on-device OCR...`);
        } else if (ext === 'pdf' || ext === 'docx') {
          setAlert(`Converting "${file.name}" to Markdown...`);
        }

        const { content, filename, warning } = await convertToMarkdown(file);
        if (rawInput) {
          rawInput.value = content;
        }
        if (filenameInp) {
          filenameInp.value = filename;
        }

        // Auto-extract title from first heading
        const titleMatch = content.match(/^#\s+(.+)$/m);
        if (titleMatch && titleInp) {
          titleInp.value = titleMatch[1].trim();
        }

        // Extract description if blockquote follows title
        const descMatch = content.match(/^#\s+.+\r?\n\r?\n>\s+(.+)$/m);
        if (descMatch && descInp) {
          descInp.value = descMatch[1].trim();
        }

        updateLivePreview();
        if (warning) {
          setAlert(warning, true);
        } else {
          setAlert(`Loaded "${file.name}" into split editor.`);
        }
      } catch (err: any) {
        setAlert(`Failed to process file: ${err.message}`, true);
      }
    }

    if (dropzone && filePicker) {
      dropzone.onclick = () => filePicker.click();
      filePicker.onchange = () => {
        if (filePicker.files && filePicker.files[0]) {
          handleLoadedFile(filePicker.files[0]);
        }
      };

      dropzone.ondragover = (e) => {
        e.preventDefault();
        dropzone.classList.add('border-read-accent', 'bg-read-accent/5');
      };
      dropzone.ondragleave = () => {
        dropzone.classList.remove('border-read-accent', 'bg-read-accent/5');
      };
      dropzone.ondrop = (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-read-accent', 'bg-read-accent/5');
        if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
          handleLoadedFile(e.dataTransfer.files[0]);
        }
      };
    }

    // Button delegation for actions
    document.addEventListener('click', async (e) => {
      const target = (e.target as HTMLElement).closest('[data-action]');
      if (!target) return;
      const action = target.getAttribute('data-action');

      if (action === 'new-draft') {
        if (rawInput) rawInput.value = '# New Article Title\n\nA brief introductory summary of this writeup.\n\n## Section 1\n\nStart writing in Markdown...';
        if (titleInp) titleInp.value = 'New Article Title';
        if (filenameInp) filenameInp.value = 'new-article.md';
        if (tagsInp) tagsInp.value = 'technical, research';
        if (descInp) descInp.value = 'A brief introductory summary of this writeup.';
        updateLivePreview();
        setAlert('Started fresh draft in split editor.');
      } else if (action === 'open-file') {
        filePicker?.click();
      } else if (action === 'preview-blog-site') {
        // Open live site preview modal
        if (!livePreviewModal) return;
        const modalTitle = document.getElementById('preview-modal-title');
        const modalDate = document.getElementById('preview-modal-date');
        const modalWords = document.getElementById('preview-modal-words');
        const modalTags = document.getElementById('preview-modal-tags');
        const modalBody = document.getElementById('preview-modal-body');
        const modalDir = document.getElementById('preview-meta-dir');

        if (modalTitle) modalTitle.textContent = titleInp?.value || 'Untitled Post';
        if (modalDate) modalDate.textContent = `# Published ${dateInp?.value || 'Today'}`;
        if (modalWords && statsEl) modalWords.textContent = statsEl.textContent || '';
        if (modalDir) modalDir.textContent = currentTrack === 'series' ? `series/${seriesNameInp?.value || 'track'}` : 'standalone';
        if (modalTags) {
          const tags = (tagsInp?.value || 'draft').split(',').map((t) => t.trim()).filter(Boolean);
          modalTags.innerHTML = tags.map((t) => `<span class="px-2 py-0.5 bg-read-bg-base border border-read-border text-read-accent rounded-[2px]">${t}</span>`).join('');
        }
        if (modalBody && rawInput) {
          modalBody.innerHTML = renderMarkdownToHtml(rawInput.value);
        }

        livePreviewModal.classList.remove('hidden');
      } else if (action === 'close-preview-modal') {
        livePreviewModal?.classList.add('hidden');
      } else if (action === 'save-post' || action === 'save-from-preview') {
        // Save post via /api/upload-blog
        const rawContent = rawInput?.value || '';
        const title = (titleInp?.value || 'Untitled Post').trim();
        let filename = (filenameInp?.value || 'untitled.md').trim();
        if (!filename.endsWith('.md') && !filename.endsWith('.mdx')) {
          filename += '.md';
        }

        const tags = (tagsInp?.value || 'standalone').split(',').map((t) => t.trim()).filter(Boolean);
        const description = (descInp?.value || '').trim();
        const pubDate = dateInp?.value || new Date().toISOString().split('T')[0];

        const payload = {
          type: currentTrack,
          seriesName: currentTrack === 'series' ? (seriesNameInp?.value || '').trim() : undefined,
          episode: currentTrack === 'series' ? parseInt(seriesPartInp?.value || '1', 10) : undefined,
          totalEpisodes: currentTrack === 'series' ? parseInt(seriesTotalInp?.value || '1', 10) : undefined,
          filename,
          content: rawContent,
          title,
          tags,
          description,
          pubDate,
        };

        try {
          const res = await fetch('/api/upload-blog', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await res.json();
          if (res.ok && result.success) {
            livePreviewModal?.classList.add('hidden');
            dirtyIndicator?.classList.add('hidden');
            setAlert(`Successfully saved to ${result.filePath}! You can now push to GitHub.`);
            // Automatically prompt with Git Push modal
            if (gitPushModal) {
              const previewEl = document.getElementById('git-cmd-preview-box');
              if (previewEl) {
                previewEl.textContent = `git add -A && git commit -m "feat(blog): publish ${filename}" && git push -u origin master`;
              }
              gitPushModal.classList.remove('hidden');
            }
          } else {
            setAlert(`Save error: ${result.error || 'Failed to save post'}`, true);
          }
        } catch (err: any) {
          setAlert(`Network error while saving: ${err.message}`, true);
        }
      } else if (action === 'open-git-push-modal') {
        if (gitPushModal) gitPushModal.classList.remove('hidden');
      } else if (action === 'close-git-push-modal') {
        if (gitPushModal) gitPushModal.classList.add('hidden');
      } else if (action === 'execute-git-push') {
        const branchSelect = document.getElementById('git-target-branch-select') as HTMLSelectElement | null;
        const msgInp = document.getElementById('git-commit-msg-inp') as HTMLInputElement | null;
        const statusLog = document.getElementById('git-push-status-log');
        const branch = branchSelect?.value || 'master';
        const message = (msgInp?.value || '').trim() || 'feat(blog): publish writeup via pomegranate dashboard';

        if (statusLog) {
          statusLog.classList.remove('hidden');
          statusLog.textContent = `[1/3] Staging changes...\n[2/3] Committing with "${message}"...\n[3/3] Pushing to origin/${branch}...`;
        }

        try {
          const res = await fetch('/api/git-push', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ branch, message }),
          });
          const data = await res.json();
          if (statusLog) {
            if (res.ok && data.success) {
              statusLog.textContent = `✓ ${data.message}\nCommit: ${data.lastCommit || 'Clean'}\n\n${data.pushOutput || ''}`;
              setAlert(`Pushed successfully to origin/${branch}! Live deploy initiated.`);
            } else {
              statusLog.textContent = `✗ Error: ${data.error || 'Git push encountered an error'}`;
              if (data.needsAuth) {
                statusLog.textContent += `\n\n→ GitHub authentication required.\nPlease open the Settings tab and connect GitHub via Device Flow.`;
                setAlert(`GitHub authentication required. Open Settings tab → Connect GitHub.`, true);
              } else {
                setAlert(`Git push failed: ${data.error || 'Check terminal status'}`, true);
              }
            }
          }
        } catch (err: any) {
          if (statusLog) statusLog.textContent = `✗ Connection error: ${err.message}`;
        }
      }
    });

    // Populate initial draft
    if (rawInput && !rawInput.value.trim()) {
      rawInput.value = `# Welcome to Pomegranate Editor\n\nA distraction-free terminal-grade writing environment.\n\n- Write or paste Markdown on the left\n- View instant rendered output on the right\n- Click "Preview Blog site" to preview with your active theme\n- Click "Save Post" to store in repository and push to GitHub\n`;
      if (titleInp && !titleInp.value) titleInp.value = 'Welcome to Pomegranate Editor';
      if (filenameInp && !filenameInp.value) filenameInp.value = 'welcome-to-pomegranate-editor.md';
      updateLivePreview();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFileUploadTab);
  } else {
    initFileUploadTab();
  }
  document.addEventListener('astro:page-load', initFileUploadTab);
</script>
