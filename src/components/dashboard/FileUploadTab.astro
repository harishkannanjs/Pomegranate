---
import fs from 'node:fs';
import path from 'node:path';
import Button from '@/components/chrome/Button.astro';
import Input from '@/components/chrome/Input.astro';
import Panel from '@/components/chrome/Panel.astro';

interface SeriesItem {
  name: string;
  displayName: string;
  totalEpisodes: number;
  nextEpisode: number;
}

const seriesList: SeriesItem[] = [];
try {
  const seriesDir = path.resolve(process.cwd(), 'Blogs', 'series');
  if (fs.existsSync(seriesDir)) {
    const folders = fs.readdirSync(seriesDir, { withFileTypes: true })
      .filter((d) => d.isDirectory())
      .map((d) => d.name);

    for (const folder of folders) {
      const folderPath = path.join(seriesDir, folder);
      const files = fs.readdirSync(folderPath).filter((f) => /\.(md|mdx)$/i.test(f));
      const displayName = folder
        .split(/[-_]+/)
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(' ');
      seriesList.push({
        name: folder,
        displayName,
        totalEpisodes: Math.max(files.length, 1),
        nextEpisode: files.length + 1,
      });
    }
  }
} catch {}
---

