---
import { getAllThemes } from '@/lib/themes';
import Button from '@/components/chrome/Button.astro';
import Input from '@/components/chrome/Input.astro';
import Panel from '@/components/chrome/Panel.astro';
import Toggle from '@/components/chrome/Toggle.astro';
import { siteConfig } from '@/site.config';

const themes = getAllThemes();

const fontOptions = [
  { id: 'consolas', name: 'Consolas', family: 'Consolas, "Courier New", Courier, monospace', desc: 'System monospace font stack (Pomegranate signature)' },
  { id: 'jetbrains-mono', name: 'JetBrains Mono', family: '"JetBrains Mono", monospace', desc: 'Modern developer monospace font with clear ligatures' },
  { id: 'fira-code', name: 'Fira Code', family: '"Fira Code", monospace', desc: 'Monospace font with programming ligatures' },
  { id: 'cascadia-code', name: 'Cascadia Code', family: '"Cascadia Code", monospace', desc: 'Modern monospace font designed by Microsoft' },
  { id: 'ibm-plex-mono', name: 'IBM Plex Mono', family: '"IBM Plex Mono", monospace', desc: 'Engineered corporate monospace typeface' },
  { id: 'source-code-pro', name: 'Source Code Pro', family: '"Source Code Pro", monospace', desc: 'Classic Adobe monospace font designed for code' },
];

const featuresConfig = siteConfig.features || {
  audioReader: true,
  readerMode: true,
  textMagnifier: true,
  copyLink: true,
  copyMarkdown: true,
  tableOfContents: true,
  readingProgressBar: true,
  relatedPosts: true,
  highlighter: true,
};

const privacyConfig = siteConfig.privacy || {
  analytics: false,
  footerNote: true,
};

const deployTargets = siteConfig.deployTargets || {};
---

<div class="settings-tab-container space-y-8 font-mono">
  <!-- Status Message Banner -->
  <div id="settings-status-banner" class="hidden p-3 border rounded-[2px] text-xs flex items-center justify-between gap-2">
    <span id="settings-status-text"></span>
    <button type="button" id="close-settings-banner-btn" class="text-read-text-tertiary hover:text-read-text-primary cursor-pointer font-bold">✕</button>
  </div>

  <!-- 1. Appearance Section -->
  <section class="space-y-4">
    <div class="flex items-center justify-between pb-2 border-b border-read-border">
      <div class="flex items-center gap-2">
        <span class="text-read-accent font-bold">&gt;</span>
        <h2 class="text-base font-bold text-read-text-primary">Appearance &amp; Theming</h2>
      </div>
      <div class="flex items-center gap-2">
        <Button variant="secondary" data-action="rerun-wizard" shortcut="Wizard">
          Setup Wizard
        </Button>
        <Button variant="secondary" data-action="reset-appearance" shortcut="Reset">
          Reset to Defaults
        </Button>
      </div>
    </div>

    <Panel title="Active Theme Picker">
      <p class="text-xs text-read-text-secondary mb-4">
        Select a theme-pack to restyle the entire reading experience and dashboard simultaneously.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3" id="theme-selector-grid">
        {themes.map((t) => {
          const darkRead = t.tokens.dark.read;
          return (
            <div
              data-theme-id={t.id}
              data-theme-mode={t.mode}
              class="theme-card relative border border-read-border hover:border-read-accent p-3.5 rounded-[2px] cursor-pointer transition-all bg-read-bg-base select-none group"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-xs text-read-text-primary group-hover:text-read-accent transition-colors">{t.name}</span>
                <span class="text-[10px] px-1.5 py-0.2 border border-read-border rounded-[2px] text-read-text-tertiary">
                  {t.mode.toUpperCase()} MODE
                </span>
              </div>

              <!-- Color Swatches Preview -->
              <div class="flex items-center gap-1.5 my-2.5">
                <div class="w-6 h-6 rounded-[2px] border border-black/20" style={`background-color: ${darkRead['bg-base']};`} title="Base BG" />
                <div class="w-6 h-6 rounded-[2px] border border-black/20" style={`background-color: ${darkRead['bg-surface']};`} title="Surface BG" />
                <div class="w-6 h-6 rounded-[2px] border border-black/20" style={`background-color: ${darkRead.accent};`} title="Accent" />
                <div class="w-6 h-6 rounded-[2px] border border-black/20" style={`background-color: ${darkRead['text-primary']};`} title="Text Primary" />
              </div>

              <!-- Font & Sample Code -->
              <div class="text-[11px] text-read-text-secondary truncate pt-1 border-t border-read-border/60">
                Font: <span class="text-read-text-primary">{t.fontFamily.split(',')[0]}</span>
              </div>
              <div class="text-[10px] text-read-text-tertiary font-mono pt-1">
                <code>const site = new Pomegranate();</code>
              </div>
            </div>
          );
        })}
      </div>
    </Panel>

    <Panel title="Typography / Font Picker">
      <p class="text-xs text-read-text-secondary mb-4">
        Choose the typography stylesheet for blog content and interface elements.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3" id="font-selector-grid">
        {fontOptions.map((f) => (
          <div
            data-font-id={f.id}
            class="font-card border border-read-border hover:border-read-accent p-3 rounded-[2px] cursor-pointer transition-all bg-read-bg-base select-none group"
          >
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-xs text-read-text-primary group-hover:text-read-accent transition-colors">{f.name}</span>
            </div>
            <p class="text-[11px] text-read-text-secondary mb-2">{f.desc}</p>
            <div class="text-xs p-2 bg-read-bg-surface border border-read-border/60 rounded-[2px] text-read-text-primary overflow-hidden whitespace-nowrap" style={`font-family: ${f.family};`}>
              The quick brown fox jumps over the lazy dog. 0123456789
            </div>
          </div>
        ))}
      </div>
    </Panel>
  </section>

  <!-- 2. Reader Features Toggles List -->
  <section class="space-y-4">
    <div class="flex items-center justify-between pb-2 border-b border-read-border">
      <div class="flex items-center gap-2">
        <span class="text-read-accent font-bold">&gt;</span>
        <h2 class="text-base font-bold text-read-text-primary">Reader Features</h2>
      </div>
      <span class="text-xs text-read-text-tertiary">Real-time live preview enabled</span>
    </div>

    <Panel title="Reader Tool Configuration">
      <p class="text-xs text-read-text-secondary mb-4">
        Individually enable or disable reader tools shown on published articles. Changes take effect on live preview immediately.
      </p>

      <div class="space-y-3 divide-y divide-read-border/60">
        <!-- 1. AudioReader -->
        <div class="pt-3 first:pt-0 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Listen (Audio Reader)</div>
            <div class="text-[11px] text-read-text-secondary">Synthesizes and speaks blog article content using on-device text-to-speech.</div>
          </div>
          <Toggle id="feature-audioReader" checked={featuresConfig.audioReader} data-feature-key="audioReader" />
        </div>

        <!-- 2. Eye Comfort / Reader Mode -->
        <div class="pt-3 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Eye Comfort (Reader Mode)</div>
            <div class="text-[11px] text-read-text-secondary">Distraction-free reading view with reduced blue light palette (Alt+R).</div>
          </div>
          <Toggle id="feature-readerMode" checked={featuresConfig.readerMode} data-feature-key="readerMode" />
        </div>

        <!-- 3. Text Magnifier -->
        <div class="pt-3 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Text Magnifier</div>
            <div class="text-[11px] text-read-text-secondary">Hover magnifying glass inspect tool for intricate code blocks and diagrams.</div>
          </div>
          <Toggle id="feature-textMagnifier" checked={featuresConfig.textMagnifier} data-feature-key="textMagnifier" />
        </div>

        <!-- 4. Copy Page Link -->
        <div class="pt-3 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Copy Page Link</div>
            <div class="text-[11px] text-read-text-secondary">Quick button to copy the direct URL with confirmation feedback.</div>
          </div>
          <Toggle id="feature-copyLink" checked={featuresConfig.copyLink} data-feature-key="copyLink" />
        </div>

        <!-- 5. Copy as Markdown -->
        <div class="pt-3 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Copy as Markdown</div>
            <div class="text-[11px] text-read-text-secondary">One-click copy of the raw Markdown source code for offline reference.</div>
          </div>
          <Toggle id="feature-copyMarkdown" checked={featuresConfig.copyMarkdown} data-feature-key="copyMarkdown" />
        </div>

        <!-- 6. Table of Contents -->
        <div class="pt-3 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Table of Contents</div>
            <div class="text-[11px] text-read-text-secondary">Sticky side rail and inline outline for navigating long-form articles.</div>
          </div>
          <Toggle id="feature-tableOfContents" checked={featuresConfig.tableOfContents} data-feature-key="tableOfContents" />
        </div>

        <!-- 7. Reading Progress Bar -->
        <div class="pt-3 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Reading Progress Bar</div>
            <div class="text-[11px] text-read-text-secondary">Top viewport progression line indicating how far the visitor has read.</div>
          </div>
          <Toggle id="feature-readingProgressBar" checked={featuresConfig.readingProgressBar} data-feature-key="readingProgressBar" />
        </div>

        <!-- 8. Related Posts -->
        <div class="pt-3 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Related Posts</div>
            <div class="text-[11px] text-read-text-secondary">Automated topic-matched related teardowns and series next reads.</div>
          </div>
          <Toggle id="feature-relatedPosts" checked={featuresConfig.relatedPosts} data-feature-key="relatedPosts" />
        </div>

        <!-- 9. Highlighter -->
        <div class="pt-3 flex items-center justify-between gap-4">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-read-text-primary">Highlighter</div>
            <div class="text-[11px] text-read-text-secondary">Visitor passage highlighter with client-side localStorage persistence.</div>
          </div>
          <Toggle id="feature-highlighter" checked={featuresConfig.highlighter} data-feature-key="highlighter" />
        </div>
      </div>
    </Panel>
  </section>

  <!-- 3. Post Management Section -->
  <section class="space-y-4">
    <div class="flex items-center justify-between pb-2 border-b border-read-border">
      <div class="flex items-center gap-2">
        <span class="text-read-accent font-bold">&gt;</span>
        <h2 class="text-base font-bold text-read-text-primary">Post Management</h2>
      </div>
      <Button variant="secondary" data-action="refresh-posts-list" shortcut="Refresh">
        Refresh List
      </Button>
    </div>

    <Panel title="Repository Articles (Blogs/)">
      <!-- Sub-tabs: Standalone vs Series -->
      <div class="flex items-center gap-2 mb-4 pb-2 border-b border-read-border text-xs">
        <button
          type="button"
          id="post-subtab-standalone"
          class="px-3 py-1 font-bold rounded-[2px] bg-read-accent text-read-bg-base cursor-pointer"
        >
          Standalone Writeups (<span id="count-standalone">0</span>)
        </button>
        <button
          type="button"
          id="post-subtab-series"
          class="px-3 py-1 text-read-text-secondary hover:text-read-text-primary rounded-[2px] cursor-pointer"
        >
          Series Tracks (<span id="count-series">0</span>)
        </button>
      </div>

      <!-- Standalone Posts List -->
      <div id="posts-list-standalone" class="space-y-2">
        <div class="text-xs text-read-text-tertiary italic p-3">Loading articles from repository...</div>
      </div>

      <!-- Series Tracks List -->
      <div id="posts-list-series" class="hidden space-y-4">
        <div class="text-xs text-read-text-tertiary italic p-3">Loading series from repository...</div>
      </div>
    </Panel>
  </section>

  <!-- 4. Deployment & GitHub Authentication Section -->
  <section class="space-y-6">
    <div class="flex items-center justify-between pb-2 border-b border-read-border">
      <div class="flex items-center gap-2">
        <span class="text-read-accent font-bold">&gt;</span>
        <h2 class="text-base font-bold text-read-text-primary">Deploy &amp; GitHub Authentication</h2>
      </div>
      <div id="github-auth-header-badge" class="flex items-center gap-2 text-xs">
        <span class="text-[11px] text-read-text-tertiary">Checking GitHub auth...</span>
      </div>
    </div>

    <!-- GitHub Device Flow Connection Panel -->
    <Panel title="GitHub Account Connection (Device Flow)">
      <div class="space-y-4 text-xs">
        <div id="gh-auth-disconnected-view" class="space-y-3">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="font-bold text-read-text-primary">Connect with GitHub Device Flow</div>
              <p class="text-read-text-secondary leading-relaxed text-[11px]">
                Authenticate with your personal GitHub account to enable one-click publishing and automated GitHub Pages setup without requiring manual command-line git configuration. No client secret is ever stored on this machine.
              </p>
            </div>
            <Button variant="primary" data-action="open-device-flow">
              Connect GitHub
            </Button>
          </div>
          <div class="p-2.5 bg-read-bg-base border border-read-border rounded-[2px] text-[11px] text-read-text-tertiary">
            ℹ Device Flow runs entirely between your local browser, local Bun process, and GitHub. No credentials ever pass through a hosted server.
          </div>
        </div>

        <div id="gh-auth-connected-view" class="hidden space-y-3">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-3 bg-read-bg-base border border-read-border rounded-[2px]">
            <div class="flex items-center gap-3">
              <div id="gh-connected-avatar-box" class="w-9 h-9 rounded-full bg-read-bg-surface border border-read-border flex items-center justify-center text-read-accent font-bold overflow-hidden shrink-0">
                <span id="gh-connected-avatar-fallback">GH</span>
                <img id="gh-connected-avatar-img" class="w-full h-full object-cover hidden" alt="GitHub Avatar" />
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-read-text-primary text-sm" id="gh-connected-username">@username</span>
                  <span class="text-[10px] px-1.5 py-0.2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-bold rounded-[2px]">
                    ✓ Connected
                  </span>
                </div>
                <div class="text-[11px] text-read-text-tertiary">
                  Scope: <code class="text-read-text-secondary" id="gh-connected-scope">repo workflow read:user</code>
                </div>
              </div>
            </div>
            <Button variant="secondary" data-action="disconnect-github">
              Disconnect
            </Button>
          </div>
        </div>
      </div>
    </Panel>

    <!-- Multi-Target Deploy Panels -->
    <Panel title="Multi-Target Deployment (4 Targets)">
      <div class="space-y-6 text-xs">
        <p class="text-read-text-secondary leading-relaxed">
          Publish your static Pomegranate articles to any of the four supported hosting targets. GitHub Pages is pre-configured and runs automatically on every commit.
        </p>

        <!-- 1. GitHub Pages (Emphasized Target) -->
        <div class="p-4 border-2 border-read-accent/80 bg-read-bg-surface-raised/40 rounded-[2px] space-y-3 shadow-lg shadow-read-accent/5">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-read-border">
            <div class="flex items-center gap-2">
              <span class="font-bold text-sm text-read-text-primary">1. GitHub Pages</span>
              <span class="text-[10px] px-2 py-0.5 bg-read-accent/15 border border-read-accent text-read-accent font-bold rounded-[2px]">
                ★ DEFAULT TARGET · ZERO SIGN-UP
              </span>
            </div>
            <Button variant="primary" data-action="enable-pages">
              Enable / Sync Pages
            </Button>
          </div>

          <p class="text-read-text-secondary text-[11px] leading-relaxed">
            Runs fully automated builds inside your repository via GitHub Actions (<code class="text-read-accent">.github/workflows/deploy.yml</code>). Zero external platform registration required.
          </p>

          <!-- Timeline status indicator -->
          <div id="gh-pages-timeline-container" class="p-2.5 bg-read-bg-base border border-read-border rounded-[2px] text-[11px] font-mono flex items-center gap-2">
            <span id="gh-pages-timeline-icon" class="text-read-accent font-bold">●</span>
            <span id="gh-pages-timeline-text" class="text-read-text-secondary">Ready to sync or trigger deployment.</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <div class="p-2.5 bg-read-bg-base border border-read-border rounded-[2px]">
              <div class="text-[10px] text-read-text-tertiary uppercase">Target Site URL</div>
              <a id="deploy-target-url" href={siteConfig.siteUrl} target="_blank" rel="noopener" class="text-read-accent font-bold hover:underline block truncate mt-0.5">
                {siteConfig.siteUrl}
              </a>
            </div>

            <div class="p-2.5 bg-read-bg-base border border-read-border rounded-[2px]">
              <div class="text-[10px] text-read-text-tertiary uppercase">Remote Repository</div>
              <a id="deploy-remote-repo" href={siteConfig.githubUrl} target="_blank" rel="noopener" class="text-read-text-primary font-bold hover:underline block truncate mt-0.5">
                {siteConfig.githubUrl || 'https://github.com/harishkannanjs/Pomegranate'}
              </a>
            </div>
          </div>

          <div class="pt-1 flex items-center justify-between text-[11px]">
            <a id="deploy-workflow-url" href="#" target="_blank" rel="noopener" class="text-read-accent hover:underline hidden">
              → View GitHub Actions Deployment Runs ↗
            </a>
            <span id="gh-pages-status-badge" class="text-[10px] text-read-text-tertiary">
              Status: Checking...
            </span>
          </div>
        </div>

        <!-- 3 External Target Cards Grid: Vercel, Netlify, Cloudflare Pages -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 pt-2">
          <!-- 2. Vercel -->
          <div class="p-3.5 bg-read-bg-base border border-read-border rounded-[2px] space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-xs text-read-text-primary">2. Vercel</span>
                <span class="text-[10px] text-read-text-tertiary font-mono">vercel.json</span>
              </div>
              <p class="text-[11px] text-read-text-secondary leading-relaxed">
                Import repository to Vercel's global edge network using zero-config static template.
              </p>
            </div>

            <div class="space-y-2.5 pt-2 border-t border-read-border">
              <Button variant="secondary" data-action="deploy-vercel" class="w-full justify-center">
                Deploy to Vercel ↗
              </Button>

              <!-- Live URL paste and display -->
              <div class="space-y-1.5 pt-1">
                <label for="target-url-vercel" class="text-[10px] text-read-text-tertiary uppercase font-mono">Paste Live URL:</label>
                <div class="flex items-center gap-1.5">
                  <Input id="target-url-vercel" placeholder="https://your-blog.vercel.app" value={deployTargets.vercel || ''} class="text-[11px]" />
                  <Button variant="secondary" data-action="save-target-vercel">Save</Button>
                </div>
                <div id="live-url-display-vercel" class="pt-1">
                  <!-- Populated dynamically -->
                </div>
              </div>
            </div>
          </div>

          <!-- 3. Netlify -->
          <div class="p-3.5 bg-read-bg-base border border-read-border rounded-[2px] space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-xs text-read-text-primary">3. Netlify</span>
                <span class="text-[10px] text-read-text-tertiary font-mono">netlify.toml</span>
              </div>
              <p class="text-[11px] text-read-text-secondary leading-relaxed">
                Connect and build with Netlify's high-performance CDN using pre-configured security headers.
              </p>
            </div>

            <div class="space-y-2.5 pt-2 border-t border-read-border">
              <Button variant="secondary" data-action="deploy-netlify" class="w-full justify-center">
                Deploy to Netlify ↗
              </Button>

              <!-- Live URL paste and display -->
              <div class="space-y-1.5 pt-1">
                <label for="target-url-netlify" class="text-[10px] text-read-text-tertiary uppercase font-mono">Paste Live URL:</label>
                <div class="flex items-center gap-1.5">
                  <Input id="target-url-netlify" placeholder="https://your-blog.netlify.app" value={deployTargets.netlify || ''} class="text-[11px]" />
                  <Button variant="secondary" data-action="save-target-netlify">Save</Button>
                </div>
                <div id="live-url-display-netlify" class="pt-1">
                  <!-- Populated dynamically -->
                </div>
              </div>
            </div>
          </div>

          <!-- 4. Cloudflare Pages -->
          <div class="p-3.5 bg-read-bg-base border border-read-border rounded-[2px] space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-xs text-read-text-primary">4. Cloudflare Pages</span>
                <span class="text-[10px] text-read-text-tertiary font-mono">wrangler.toml</span>
              </div>
              <p class="text-[11px] text-read-text-secondary leading-relaxed">
                Zero cold-start edge distribution configured via root static build output.
              </p>
            </div>

            <div class="space-y-2.5 pt-2 border-t border-read-border">
              <Button variant="secondary" data-action="deploy-cloudflare" class="w-full justify-center">
                Deploy to Cloudflare ↗
              </Button>

              <!-- Live URL paste and display -->
              <div class="space-y-1.5 pt-1">
                <label for="target-url-cloudflare" class="text-[10px] text-read-text-tertiary uppercase font-mono">Paste Live URL:</label>
                <div class="flex items-center gap-1.5">
                  <Input id="target-url-cloudflare" placeholder="https://your-blog.pages.dev" value={deployTargets.cloudflare || ''} class="text-[11px]" />
                  <Button variant="secondary" data-action="save-target-cloudflare">Save</Button>
                </div>
                <div id="live-url-display-cloudflare" class="pt-1">
                  <!-- Populated dynamically -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Panel>
  </section>

  <!-- 5. Privacy Section -->
  <section class="space-y-4">
    <div class="flex items-center gap-2 pb-2 border-b border-read-border">
      <span class="text-read-accent font-bold">&gt;</span>
      <h2 class="text-base font-bold text-read-text-primary">Privacy &amp; Data Storage</h2>
    </div>

    <Panel title="Visitor Data Explainer">
      <div class="space-y-4 text-xs">
        <p class="text-read-text-secondary leading-relaxed">
          Pomegranate is designed around a zero-knowledge, visitor-first privacy architecture:
        </p>
        <ul class="list-disc pl-4 space-y-1.5 text-read-text-secondary text-[11px]">
          <li><strong>Visitor Preferences</strong> (theme mode, active font, reading position, and highlights) live exclusively in the visitor's local browser (<code class="text-read-accent">localStorage</code>).</li>
          <li><strong>Zero Tracking Telemetry:</strong> No remote logging servers, third-party analytics cookies, or behavioral trackers are loaded.</li>
          <li><strong>Author Identity:</strong> Contained entirely in <code class="text-read-accent">profile.json</code> within your repository.</li>
        </ul>

        <div class="pt-3 border-t border-read-border space-y-3">
          <div class="flex items-center justify-between gap-4">
            <div class="space-y-0.5">
              <div class="text-xs font-bold text-read-text-primary">Opt-in Cookie-Free Analytics</div>
              <div class="text-[11px] text-read-text-secondary">Allow aggregate, privacy-preserving visits without tracking individual identities.</div>
            </div>
            <Toggle id="privacy-analytics" checked={privacyConfig.analytics} data-privacy-key="analytics" />
          </div>

          <div class="flex items-center justify-between gap-4">
            <div class="space-y-0.5">
              <div class="text-xs font-bold text-read-text-primary">Footer Privacy Notice</div>
              <div class="text-[11px] text-read-text-secondary">Display a badge in the blog footer: "Privacy-first blog · No cookies or trackers".</div>
            </div>
            <Toggle id="privacy-footerNote" checked={privacyConfig.footerNote} data-privacy-key="footerNote" />
          </div>
        </div>
      </div>
    </Panel>
  </section>

  <!-- 6. Advanced Section -->
  <section class="space-y-4">
    <div class="flex items-center gap-2 pb-2 border-b border-read-border">
      <span class="text-read-accent font-bold">&gt;</span>
      <h2 class="text-base font-bold text-read-text-primary">Advanced Operations</h2>
    </div>

    <Panel title="Data Tools &amp; Recovery">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <!-- Export Site ZIP -->
        <div class="p-3 bg-read-bg-base border border-read-border rounded-[2px] space-y-2">
          <div class="font-bold text-read-text-primary">Export Site Archive</div>
          <p class="text-[11px] text-read-text-secondary">Download a compressed ZIP containing your entire blog posts, configuration, and assets.</p>
          <Button variant="secondary" data-action="export-site-zip">Export Site as ZIP</Button>
        </div>

        <!-- Undo Last Change (Git Revert) -->
        <div class="p-3 bg-read-bg-base border border-read-border rounded-[2px] space-y-2">
          <div class="font-bold text-read-text-primary">Undo Last Change (Git Revert)</div>
          <p class="text-[11px] text-read-text-secondary">Create a safe revert commit for the most recent repository commit.</p>
          <Button variant="secondary" data-action="undo-last-change">Revert Last Commit</Button>
        </div>
      </div>

      <!-- BYOK API Integrations (Groq Whisper) -->
      <div class="mt-4 pt-4 border-t border-read-border space-y-3">
        <div class="flex items-center justify-between text-xs">
          <div class="flex items-center gap-2">
            <span class="font-bold text-read-text-primary">BYOK API Integrations (Groq Whisper)</span>
            <span class="text-[10px] text-read-accent px-1.5 py-0.2 border border-read-accent rounded-[2px] font-bold">Tier 2 Audio</span>
          </div>
          <Button variant="secondary" data-action="save-groq-key">Save Groq Key</Button>
        </div>

        <p class="text-[11px] text-read-text-secondary leading-relaxed">
          Provide your own Groq API key to transcribe speech from audio files (<code class="text-read-accent">.mp3</code>, <code class="text-read-accent">.wav</code>, <code class="text-read-accent">.m4a</code>) into Markdown writeups using Groq-hosted Whisper Large V3.
        </p>

        <div class="space-y-1">
          <label for="byok-groq-key" class="text-[11px] text-read-text-secondary">Groq API Key (starts with <code>gsk_...</code>):</label>
          <div class="flex items-center gap-2">
            <div class="flex-1">
              <Input id="byok-groq-key" type="password" placeholder="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
            </div>
            <Button variant="secondary" data-action="toggle-groq-key-visibility">Show</Button>
            <Button variant="secondary" data-action="clear-groq-key">Clear</Button>
          </div>
        </div>

        <div class="p-2.5 bg-read-bg-surface border border-read-border rounded-[2px] text-[11px] text-read-text-tertiary space-y-1">
          <div class="flex items-center gap-1.5 text-read-text-secondary font-semibold">
            <span>🔒</span>
            <span>Zero-Knowledge BYOK Guarantee:</span>
          </div>
          <p>
            Your Groq API key is stored locally in your browser's <code class="text-read-accent">localStorage</code>. It is communicated directly to Groq's official API (<code class="text-read-accent">api.groq.com</code>) exclusively when you explicitly confirm an audio transcription request. It is never logged, analyzed, or committed into git repository files.
          </p>
        </div>
      </div>

      <!-- Raw Configuration Viewer -->
      <div class="mt-4 pt-4 border-t border-read-border space-y-2">
        <div class="flex items-center justify-between text-xs">
          <span class="font-bold text-read-text-primary">Raw Configuration (profile.json)</span>
          <Button variant="secondary" data-action="save-raw-config">Save Raw JSON</Button>
        </div>
        <textarea
          id="raw-config-editor"
          class="w-full h-44 p-3 bg-read-bg-base border border-read-border text-xs font-mono text-read-text-primary rounded-[2px] focus:border-read-accent focus:outline-none"
          spellcheck="false"
        >{JSON.stringify(siteConfig, null, 2)}</textarea>
      </div>

      <!-- Danger Zone -->
      <div class="mt-4 pt-4 border-t border-red-500/30 space-y-3 text-xs">
        <div class="text-xs font-bold text-red-400 uppercase tracking-wider">Danger Zone</div>
        <div class="flex flex-wrap items-center justify-between gap-3 p-3 bg-red-500/5 border border-red-500/30 rounded-[2px]">
          <div>
            <div class="font-bold text-red-400">Disconnect GitHub</div>
            <div class="text-[11px] text-read-text-secondary">
              Wipe locally stored authentication token. (To revoke remote OAuth access, visit <a href="https://github.com/settings/connections/applications" target="_blank" rel="noopener" class="text-read-accent hover:underline">GitHub Authorized Applications ↗</a>).
            </div>
          </div>
          <div class="flex items-center gap-2">
            <Button variant="danger" data-action="disconnect-github">Disconnect</Button>
          </div>
        </div>
      </div>
    </Panel>
  </section>

  <!-- 7. Author Profile Identity Section -->
  <section class="space-y-4">
    <div class="flex items-center gap-2 pb-2 border-b border-read-border">
      <span class="text-read-accent font-bold">&gt;</span>
      <h2 class="text-base font-bold text-read-text-primary">Author Profile Details</h2>
    </div>

    <Panel title="Author Bio &amp; Coordinates">
      <div class="space-y-3 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="prof-author-name" class="text-[11px] text-read-text-secondary">Author Name:</label>
            <Input id="prof-author-name" value={siteConfig.author} />
          </div>
          <div class="space-y-1">
            <label for="prof-author-handle" class="text-[11px] text-read-text-secondary">Handle (@username):</label>
            <Input id="prof-author-handle" value={siteConfig.handle} />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="prof-author-role" class="text-[11px] text-read-text-secondary">Role / Tagline:</label>
            <Input id="prof-author-role" value={siteConfig.role} />
          </div>
          <div class="space-y-1">
            <label for="prof-author-email" class="text-[11px] text-read-text-secondary">Email:</label>
            <Input id="prof-author-email" value={siteConfig.email} />
          </div>
        </div>

        <div class="space-y-1">
          <label for="prof-author-bio" class="text-[11px] text-read-text-secondary">Bio / Description:</label>
          <textarea
            id="prof-author-bio"
            class="w-full h-20 p-2.5 bg-read-bg-base border border-read-border text-xs text-read-text-primary rounded-[2px] focus:border-read-accent focus:outline-none"
          >{siteConfig.description}</textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="prof-author-github" class="text-[11px] text-read-text-secondary">GitHub Profile URL:</label>
            <Input id="prof-author-github" value={siteConfig.githubUrl} />
          </div>
          <div class="space-y-1">
            <label for="prof-author-twitter" class="text-[11px] text-read-text-secondary">Twitter / X URL:</label>
            <Input id="prof-author-twitter" value={siteConfig.twitterUrl} />
          </div>
        </div>

        <div class="pt-2 flex justify-end">
          <Button variant="primary" data-action="save-author-profile">Save Author Profile</Button>
        </div>
      </div>
    </Panel>
  </section>

  <!-- GitHub Device Flow Authentication Modal -->
  <div id="device-flow-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6 font-mono">
    <div class="bg-read-bg-base border border-read-border-strong w-full max-w-md rounded-[2px] shadow-2xl p-6 space-y-5">
      <div class="flex items-center justify-between border-b border-read-border pb-3">
        <div class="flex items-center gap-2 text-xs">
          <span class="text-read-accent font-bold">&gt;</span>
          <span class="text-read-text-primary font-bold">Connect GitHub (Device Flow)</span>
        </div>
        <button type="button" data-action="close-device-flow-modal" class="text-read-text-tertiary hover:text-read-text-primary font-bold cursor-pointer">✕</button>
      </div>

      <div class="space-y-3 text-xs">
        <p class="text-read-text-secondary leading-relaxed">
          1. Copy your one-time user verification code:
        </p>

        <div class="flex items-center justify-between gap-3 p-3 bg-read-bg-surface border border-read-border rounded-[2px]">
          <div id="device-flow-user-code" class="text-xl sm:text-2xl font-bold tracking-widest text-read-accent select-all">
            --------
          </div>
          <Button variant="secondary" data-action="copy-device-code">
            Copy Code
          </Button>
        </div>

        <p class="text-read-text-secondary leading-relaxed">
          2. Visit GitHub's device activation page and authorize Pomegranate:
        </p>

        <Button variant="primary" data-action="open-device-url" class="w-full justify-center">
          Open github.com/login/device ↗
        </Button>
      </div>

      <div class="p-3 bg-read-bg-surface border border-read-border rounded-[2px] space-y-1.5 text-[11px]">
        <div class="flex items-center gap-2 font-bold text-read-text-primary">
          <span id="device-flow-spinner" class="animate-spin text-read-accent">◒</span>
          <span id="device-flow-status-text">Requesting device authorization code...</span>
        </div>
        <div class="text-read-text-tertiary text-[10px]">
          Direct local polling between your Bun process and api.github.com. Zero intermediary servers.
        </div>
      </div>

      <div class="flex justify-end pt-1">
        <Button variant="secondary" data-action="close-device-flow-modal">
          Cancel
        </Button>
      </div>
    </div>
  </div>
</div>

<script>
  function initSettingsTab() {
    const statusBanner = document.getElementById('settings-status-banner');
    const statusText = document.getElementById('settings-status-text');
    const closeBannerBtn = document.getElementById('close-settings-banner-btn');

    function notify(msg: string, isError = false) {
      if (!statusBanner || !statusText) return;
      statusText.textContent = msg;
      statusBanner.classList.remove('hidden', 'bg-read-accent/10', 'border-read-accent', 'bg-red-500/10', 'border-red-500', 'text-red-400');
      if (isError) {
        statusBanner.classList.add('bg-red-500/10', 'border-red-500', 'text-red-400');
      } else {
        statusBanner.classList.add('bg-read-accent/10', 'border-read-accent', 'text-read-accent');
      }
    }

    if (closeBannerBtn) {
      closeBannerBtn.onclick = () => statusBanner?.classList.add('hidden');
    }

    // 1. Theme and Font Selection
    const themeCards = document.querySelectorAll('.theme-card');
    const fontCards = document.querySelectorAll('.font-card');

    function highlightActiveThemeAndFont() {
      let currentTheme = document.documentElement.getAttribute('data-theme') || localStorage.getItem('pomegranate_theme');
      if (!currentTheme) {
        const legacyTheme = localStorage.getItem('blogly_theme');
        if (legacyTheme) {
          currentTheme = legacyTheme === 'blogly' ? 'pomegranate' : legacyTheme;
          try {
            localStorage.setItem('pomegranate_theme', currentTheme);
            localStorage.removeItem('blogly_theme');
          } catch {}
        }
      }
      if (!currentTheme) currentTheme = 'pomegranate';

      let currentFont = document.documentElement.getAttribute('data-font') || localStorage.getItem('pomegranate_font');
      if (!currentFont) {
        const legacyFont = localStorage.getItem('blogly_font');
        if (legacyFont) {
          currentFont = legacyFont === 'monocraft' ? 'consolas' : legacyFont;
          try {
            localStorage.setItem('pomegranate_font', currentFont);
            localStorage.removeItem('blogly_font');
          } catch {}
        }
      }
      if (!currentFont) currentFont = 'consolas';

      themeCards.forEach((c) => {
        const id = c.getAttribute('data-theme-id');
        if (id === currentTheme) {
          c.classList.add('border-read-accent', 'ring-1', 'ring-read-accent');
        } else {
          c.classList.remove('border-read-accent', 'ring-1', 'ring-read-accent');
        }
      });

      fontCards.forEach((c) => {
        const id = c.getAttribute('data-font-id');
        if (id === currentFont) {
          c.classList.add('border-read-accent', 'ring-1', 'ring-read-accent');
        } else {
          c.classList.remove('border-read-accent', 'ring-1', 'ring-read-accent');
        }
      });
    }

    highlightActiveThemeAndFont();

    themeCards.forEach((card) => {
      card.addEventListener('click', async () => {
        const themeId = card.getAttribute('data-theme-id') || 'pomegranate';
        document.documentElement.setAttribute('data-theme', themeId);
        localStorage.setItem('pomegranate_theme', themeId);
        localStorage.removeItem('blogly_theme');
        highlightActiveThemeAndFont();
        notify(`Switched theme to ${themeId}.`);

        const currentFont = document.documentElement.getAttribute('data-font') || localStorage.getItem('pomegranate_font') || 'consolas';
        try {
          await fetch('/api/save-profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ appearance: { theme: themeId, font: currentFont } }),
          });
        } catch {}
      });
    });

    fontCards.forEach((card) => {
      card.addEventListener('click', async () => {
        const fontId = card.getAttribute('data-font-id') || 'consolas';
        document.documentElement.setAttribute('data-font', fontId);
        localStorage.setItem('pomegranate_font', fontId);
        localStorage.removeItem('blogly_font');
        highlightActiveThemeAndFont();
        notify(`Switched typography font to ${fontId}.`);

        const currentTheme = document.documentElement.getAttribute('data-theme') || localStorage.getItem('pomegranate_theme') || 'pomegranate';
        try {
          await fetch('/api/save-profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ appearance: { theme: currentTheme, font: fontId } }),
          });
        } catch {}
      });
    });

    // 2. Feature Toggles
    const featureToggles = document.querySelectorAll('[data-feature-key]');
    featureToggles.forEach((toggleEl) => {
      const input = toggleEl.querySelector('input[type="checkbox"]') as HTMLInputElement | null;
      if (!input) return;
      const key = toggleEl.getAttribute('data-feature-key');

      // Initialize from localStorage if present (with fallback to legacy blogly_features)
      try {
        let raw = localStorage.getItem('pomegranate_features');
        if (!raw) {
          const legacyRaw = localStorage.getItem('blogly_features');
          if (legacyRaw) {
            raw = legacyRaw;
            try {
              localStorage.setItem('pomegranate_features', legacyRaw);
              localStorage.removeItem('blogly_features');
            } catch {}
          }
        }
        if (raw) {
          const map = JSON.parse(raw);
          if (key && key in map) {
            input.checked = Boolean(map[key]);
          }
        }
      } catch {}

      input.addEventListener('change', async () => {
        if (!key) return;
        const enabled = input.checked;
        let map: Record<string, boolean> = {};
        try {
          map = JSON.parse(localStorage.getItem('pomegranate_features') || localStorage.getItem('blogly_features') || '{}');
        } catch {}
        map[key] = enabled;
        localStorage.setItem('pomegranate_features', JSON.stringify(map));
        localStorage.removeItem('blogly_features');

        notify(`Feature "${key}" ${enabled ? 'enabled' : 'disabled'}. Live preview updated.`);

        try {
          await fetch('/api/save-profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ features: map }),
          });
        } catch {}
      });
    });

    // 3. Privacy Toggles
    const privacyToggles = document.querySelectorAll('[data-privacy-key]');
    privacyToggles.forEach((toggleEl) => {
      const input = toggleEl.querySelector('input[type="checkbox"]') as HTMLInputElement | null;
      if (!input) return;
      const key = toggleEl.getAttribute('data-privacy-key');

      // Initialize from localStorage if present (with fallback to legacy blogly_privacy)
      try {
        let raw = localStorage.getItem('pomegranate_privacy');
        if (!raw) {
          const legacyRaw = localStorage.getItem('blogly_privacy');
          if (legacyRaw) {
            raw = legacyRaw;
            try {
              localStorage.setItem('pomegranate_privacy', legacyRaw);
              localStorage.removeItem('blogly_privacy');
            } catch {}
          }
        }
        if (raw) {
          const map = JSON.parse(raw);
          if (key && key in map) {
            input.checked = Boolean(map[key]);
          }
        }
      } catch {}

      input.addEventListener('change', async () => {
        if (!key) return;
        const enabled = input.checked;
        let map: Record<string, boolean> = {};
        try {
          map = JSON.parse(localStorage.getItem('pomegranate_privacy') || localStorage.getItem('blogly_privacy') || '{}');
        } catch {}
        map[key] = enabled;
        localStorage.setItem('pomegranate_privacy', JSON.stringify(map));
        localStorage.removeItem('blogly_privacy');

        notify(`Privacy option "${key}" updated.`);

        try {
          await fetch('/api/save-profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ privacy: map }),
          });
        } catch {}
      });
    });

    // 4. Post Management Loading & Interactions
    const standaloneListEl = document.getElementById('posts-list-standalone');
    const seriesListEl = document.getElementById('posts-list-series');
    const countStandaloneEl = document.getElementById('count-standalone');
    const countSeriesEl = document.getElementById('count-series');
    const subtabStandaloneBtn = document.getElementById('post-subtab-standalone');
    const subtabSeriesBtn = document.getElementById('post-subtab-series');

    async function loadPostsList() {
      try {
        const res = await fetch('/api/list-blogs');
        const data = await res.json();
        if (!res.ok || !data.success) return;

        const blogs = data.blogs || [];
        const standalonePosts = blogs.filter((b: any) => b.type === 'standalone');
        const seriesPosts = blogs.filter((b: any) => b.type === 'series');

        if (countStandaloneEl) countStandaloneEl.textContent = String(standalonePosts.length);
        if (countSeriesEl) countSeriesEl.textContent = String(seriesPosts.length);

        const escapeHtml = (str: any) =>
          String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');

        // Render standalone
        if (standaloneListEl) {
          if (standalonePosts.length === 0) {
            standaloneListEl.innerHTML = '<div class="text-xs text-read-text-tertiary p-3">No standalone articles found in Blogs/standalone/.</div>';
          } else {
            standaloneListEl.innerHTML = standalonePosts.map((p: any) => `
              <div class="p-3 bg-read-bg-base border border-read-border rounded-[2px] flex items-center justify-between gap-3 text-xs">
                <div class="space-y-0.5 truncate">
                  <div class="font-bold text-read-text-primary truncate">${escapeHtml(p.title)}</div>
                  <div class="text-[11px] text-read-text-tertiary truncate"><code>${escapeHtml(p.relPath)}</code> · ${escapeHtml(p.date || 'Unpublished')}</div>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  <a href="${escapeHtml(p.url)}" target="_blank" class="px-2 py-1 bg-read-bg-surface border border-read-border hover:border-read-accent text-read-text-secondary hover:text-read-accent rounded-[2px] text-[11px]">View</a>
                  <button type="button" data-edit-post="${escapeHtml(p.relPath)}" class="px-2 py-1 bg-read-bg-surface border border-read-border hover:border-read-accent text-read-text-secondary hover:text-read-accent rounded-[2px] text-[11px] cursor-pointer">Edit</button>
                  <button type="button" data-delete-post="${escapeHtml(p.relPath)}" data-post-title="${escapeHtml(p.title)}" class="px-2 py-1 bg-read-bg-surface border border-red-500/30 hover:border-red-500 text-red-400 rounded-[2px] text-[11px] cursor-pointer">Delete</button>
                </div>
              </div>
            `).join('');
          }
        }

        // Render series grouped
        if (seriesListEl) {
          const seriesGroup: Record<string, any[]> = {};
          seriesPosts.forEach((p: any) => {
            const sName = p.seriesName || 'general';
            if (!seriesGroup[sName]) seriesGroup[sName] = [];
            seriesGroup[sName].push(p);
          });

          const seriesNames = Object.keys(seriesGroup);
          if (seriesNames.length === 0) {
            seriesListEl.innerHTML = '<div class="text-xs text-read-text-tertiary p-3">No series tracks found in Blogs/series/.</div>';
          } else {
            seriesListEl.innerHTML = seriesNames.map((sName) => {
              const entries = seriesGroup[sName].sort((a, b) => (a.episode || 1) - (b.episode || 1));
              return `
                <div class="p-3 bg-read-bg-base border border-read-border rounded-[2px] space-y-2.5 text-xs">
                  <div class="flex items-center justify-between pb-1.5 border-b border-read-border">
                    <span class="font-bold text-read-accent uppercase text-[11px]">Series: "${escapeHtml(sName)}" (${entries.length} episodes)</span>
                  </div>
                  <div class="space-y-1.5" data-series-container="${escapeHtml(sName)}">
                    ${entries.map((ep, idx) => `
                      <div class="p-2 bg-read-bg-surface border border-read-border/70 rounded-[2px] flex items-center justify-between gap-2" data-series-file="${escapeHtml(ep.filename)}" data-ep-idx="${idx}">
                        <div class="truncate text-read-text-primary text-[11px]">
                          <span class="text-read-accent font-bold">[Ep ${ep.episode || idx + 1}]</span> ${escapeHtml(ep.title)}
                        </div>
                        <div class="flex items-center gap-1 shrink-0">
                          <button type="button" data-reorder-up="${escapeHtml(sName)}" data-file="${escapeHtml(ep.filename)}" class="px-1.5 py-0.5 bg-read-bg-base border border-read-border text-read-text-secondary hover:text-read-accent cursor-pointer ${idx === 0 ? 'opacity-30 pointer-events-none' : ''}">↑</button>
                          <button type="button" data-reorder-down="${escapeHtml(sName)}" data-file="${escapeHtml(ep.filename)}" class="px-1.5 py-0.5 bg-read-bg-base border border-read-border text-read-text-secondary hover:text-read-accent cursor-pointer ${idx === entries.length - 1 ? 'opacity-30 pointer-events-none' : ''}">↓</button>
                          <button type="button" data-edit-post="${escapeHtml(ep.relPath)}" class="px-1.5 py-0.5 bg-read-bg-base border border-read-border text-read-text-secondary hover:text-read-accent cursor-pointer text-[10px]">Edit</button>
                          <button type="button" data-delete-post="${escapeHtml(ep.relPath)}" data-post-title="${escapeHtml(ep.title)}" class="px-1.5 py-0.5 bg-read-bg-base border border-red-500/30 text-red-400 hover:text-red-300 cursor-pointer text-[10px]">✕</button>
                        </div>
                      </div>
                    `).join('')}
                  </div>
                </div>
