    // Reorder episodes handler
    document.addEventListener('click', async (e) => {
      const upBtn = (e.target as HTMLElement).closest('[data-reorder-up]');
      const downBtn = (e.target as HTMLElement).closest('[data-reorder-down]');
      const btn = upBtn || downBtn;
      if (!btn) return;

      const sName = btn.getAttribute('data-reorder-up') || btn.getAttribute('data-reorder-down');
      const filename = btn.getAttribute('data-file');
      if (!sName || !filename) return;

      const container = document.querySelector(`[data-series-container="${sName}"]`);
      if (!container) return;

      const rows = Array.from(container.querySelectorAll('[data-series-file]'));
      const filenames = rows.map((r) => r.getAttribute('data-series-file') || '');
      const idx = filenames.indexOf(filename);
      if (idx === -1) return;

      if (upBtn && idx > 0) {
        const tmp = filenames[idx - 1];
        filenames[idx - 1] = filenames[idx];
        filenames[idx] = tmp;
      } else if (downBtn && idx < filenames.length - 1) {
        const tmp = filenames[idx + 1];
        filenames[idx + 1] = filenames[idx];
        filenames[idx] = tmp;
      }

      try {
        const res = await fetch('/api/reorder-series', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ seriesName: sName, episodeOrder: filenames }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          notify(data.message || 'Series episodes reordered successfully.');
          loadPostsList();
        } else {
          notify(`Failed to reorder: ${data.error || 'Unknown error'}`, true);
        }
      } catch (err: any) {
        notify(`Reorder error: ${err.message}`, true);
      }
    });

