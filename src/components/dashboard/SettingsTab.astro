    // 6. Device Flow and Deployment Handlers
    let deviceFlowInterval: any = null;
    let currentVerificationUri = 'https://github.com/login/device';
    let remoteRepoWebUrl = '';

    function openDeviceFlowModal() {
      const modal = document.getElementById('device-flow-modal');
      const codeEl = document.getElementById('device-flow-user-code');
      const statusEl = document.getElementById('device-flow-status-text');
      if (modal) modal.classList.remove('hidden');
      if (codeEl) codeEl.textContent = '--------';
      if (statusEl) statusEl.textContent = 'Requesting device authorization code from GitHub...';

      fetch('/api/device-code', { method: 'POST' })
        .then((r) => r.json())
        .then((data) => {
          const userCode = data.userCode || data.user_code;
          const deviceCode = data.deviceCode || data.device_code;
          const verificationUri = data.verificationUri || data.verification_uri || 'https://github.com/login/device';
          if (data.success && userCode && deviceCode) {
            if (codeEl) codeEl.textContent = userCode;
            currentVerificationUri = verificationUri;
            if (statusEl) {
              statusEl.textContent = `Enter code at ${currentVerificationUri}. Waiting for authorization...`;
            }
            startDeviceFlowPolling(deviceCode, data.interval || 5);
          } else {
            if (statusEl) statusEl.textContent = `Error: ${data.error || 'Failed to initiate device flow'}`;
            notify(`Device flow error: ${data.error || 'Failed to initiate'}`, true);
          }
        })
        .catch((err) => {
          if (statusEl) statusEl.textContent = `Network error: ${err.message}`;
          notify(`Connection error: ${err.message}`, true);
        });
    }

    function closeDeviceFlowModal() {
      const modal = document.getElementById('device-flow-modal');
      if (modal) modal.classList.add('hidden');
      if (deviceFlowInterval) {
        clearInterval(deviceFlowInterval);
        deviceFlowInterval = null;
      }
    }

    function startDeviceFlowPolling(deviceCode: string, intervalSec: number) {
      if (deviceFlowInterval) clearInterval(deviceFlowInterval);
      let pollIntervalMs = Math.max(intervalSec * 1000, 5000);

      const poll = async () => {
        const statusEl = document.getElementById('device-flow-status-text');
        try {
          const res = await fetch('/api/device-poll', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ deviceCode, device_code: deviceCode }),
          });
          const data = await res.json();

          if (data.status === 'pending' || data.status === 'authorization_pending') {
            if (statusEl) statusEl.textContent = 'Waiting for user authorization on GitHub...';
          } else if (data.status === 'slow_down') {
            pollIntervalMs += 5000;
            clearInterval(deviceFlowInterval);
            deviceFlowInterval = setInterval(poll, pollIntervalMs);
          } else if (data.status === 'complete' || data.status === 'success') {
            clearInterval(deviceFlowInterval);
            deviceFlowInterval = null;
            const username = data.authStatus?.username || data.user?.login || 'user';
            if (statusEl) statusEl.textContent = `Connected as @${username}!`;
            notify(`Connected to GitHub as @${username}!`);
            setTimeout(() => {
              closeDeviceFlowModal();
              checkAuthStatus();
              checkDeployStatus();
            }, 1200);
          } else if (data.status === 'expired' || data.status === 'expired_token') {
            clearInterval(deviceFlowInterval);
            deviceFlowInterval = null;
            if (statusEl) statusEl.textContent = 'Device code expired. Please try again.';
            notify('Device flow code expired. Please initiate again.', true);
          } else if (data.status === 'denied' || data.status === 'access_denied') {
            clearInterval(deviceFlowInterval);
            deviceFlowInterval = null;
            if (statusEl) statusEl.textContent = 'Authorization was denied on GitHub.';
            notify('GitHub authorization was denied.', true);
          } else {
            clearInterval(deviceFlowInterval);
            deviceFlowInterval = null;
            if (statusEl) statusEl.textContent = `Error: ${data.error || 'Authentication failed'}`;
            notify(`Authentication error: ${data.error || 'Unknown error'}`, true);
          }
        } catch {
          // Continue polling on transient network hiccup
        }
      };

      deviceFlowInterval = setInterval(poll, pollIntervalMs);
    }

    async function checkAuthStatus() {
      const disconnectedView = document.getElementById('gh-auth-disconnected-view');
      const connectedView = document.getElementById('gh-auth-connected-view');
      const usernameEl = document.getElementById('gh-connected-username');
      const scopeEl = document.getElementById('gh-connected-scope');
      const avatarImg = document.getElementById('gh-connected-avatar-img') as HTMLImageElement | null;
      const avatarFallback = document.getElementById('gh-connected-avatar-fallback');

      try {
        const res = await fetch('/api/auth-status?verify=true');
        const data = await res.json();
        if (res.ok && data.connected) {
          if (disconnectedView) disconnectedView.classList.add('hidden');
          if (connectedView) connectedView.classList.remove('hidden');
          if (usernameEl) usernameEl.textContent = `@${data.username}`;
          if (scopeEl && (data.scope || data.scopes)) scopeEl.textContent = data.scope || data.scopes;
          if (data.avatarUrl && avatarImg && avatarFallback) {
            avatarImg.src = data.avatarUrl;
            avatarImg.classList.remove('hidden');
            avatarFallback.classList.add('hidden');
          }
        } else {
          if (disconnectedView) disconnectedView.classList.remove('hidden');
          if (connectedView) connectedView.classList.add('hidden');
          if (data.expired) {
            notify('GitHub token has expired or was revoked. Please reconnect via Device Flow.', true);
          }
        }
      } catch {}
    }

    async function disconnectGitHub() {
      if (!confirm('Disconnect GitHub? This wipes your locally stored token in .pomegranate/auth.json.')) {
        return;
      }
      try {
        const res = await fetch('/api/disconnect-github', { method: 'POST' });
        const data = await res.json();
        if (res.ok && data.success) {
          notify('Disconnected from GitHub. Local token wiped.');
          checkAuthStatus();
        } else {
          notify(`Disconnect error: ${data.error || 'Failed to disconnect'}`, true);
        }
      } catch (err: any) {
        notify(`Network error: ${err.message}`, true);
      }
    }

    async function enableOrSyncPages() {
      const timelineText = document.getElementById('gh-pages-timeline-text');
      const timelineIcon = document.getElementById('gh-pages-timeline-icon');
      const statusBadge = document.getElementById('gh-pages-status-badge');

      if (timelineText) timelineText.textContent = 'Checking repository & configuring GitHub Pages...';
      if (timelineIcon) timelineIcon.className = 'text-amber-400 font-bold animate-pulse';

      try {
        const res = await fetch('/api/enable-pages', { method: 'POST' });
        const data = await res.json();

        if (data.needsAuth) {
          if (timelineText) timelineText.textContent = 'Authentication required. Connect GitHub via Device Flow above.';
          if (timelineIcon) timelineIcon.className = 'text-red-400 font-bold';
          notify('GitHub connection required to configure Pages.', true);
          openDeviceFlowModal();
          return;
        }

        if (res.ok && data.success) {
          if (timelineText) {
            timelineText.textContent = `Enabling Pages ✓ → Workflow running… → Live at ${data.pagesUrl || 'Pages URL'}`;
          }
          if (timelineIcon) timelineIcon.className = 'text-emerald-400 font-bold';
          if (statusBadge) statusBadge.textContent = `Status: ${data.pagesStatus || 'active'}`;

          const targetUrlEl = document.getElementById('deploy-target-url') as HTMLAnchorElement | null;
          if (targetUrlEl && data.pagesUrl) {
            targetUrlEl.href = data.pagesUrl;
            targetUrlEl.textContent = data.pagesUrl;
          }
          notify(data.message || 'GitHub Pages configured successfully!');
        } else {
          if (timelineText) timelineText.textContent = `Pages setup: ${data.error || 'Failed to configure Pages'}`;
          if (timelineIcon) timelineIcon.className = 'text-red-400 font-bold';
          notify(`GitHub Pages error: ${data.error || 'Failed to configure'}`, true);
        }
      } catch (err: any) {
        if (timelineText) timelineText.textContent = `Network error: ${err.message}`;
        notify(`Network error: ${err.message}`, true);
      }
    }

    function updateLiveUrlDisplay(target: string, url: string) {
      const displayEl = document.getElementById(`live-url-display-${target}`);
      if (!displayEl) return;
      displayEl.replaceChildren();
      if (!url) return;

      // Validate URL scheme: only allow http: and https: to prevent javascript: or data: XSS
      try {
        const parsed = new URL(url);
        if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
          return;
        }
      } catch {
        return;
      }

      const container = document.createElement('div');
      container.className = 'flex items-center gap-1.5 text-[11px] text-read-accent';

      const bullet = document.createElement('span');
      bullet.textContent = '●';

      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.className = 'underline hover:opacity-80 truncate';
      link.textContent = `${url} ↗`;

      container.appendChild(bullet);
      container.appendChild(link);
      displayEl.appendChild(container);
    }

    async function saveDeployTargetUrl(target: 'vercel' | 'netlify' | 'cloudflare') {
      const inputEl = document.getElementById(`target-url-${target}`) as HTMLInputElement | null;
      const url = (inputEl?.value || '').trim();
      try {
        const res = await fetch('/api/save-deploy-target', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target, url }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          updateLiveUrlDisplay(target, url);
          notify(`Saved ${target} live URL!`);
        } else {
          notify(`Failed to save ${target} URL: ${data.error || 'Unknown error'}`, true);
        }
      } catch (err: any) {
        notify(`Save error: ${err.message}`, true);
      }
    }

    async function checkDeployStatus() {
      try {
        const res = await fetch('/api/deploy-status');
        const data = await res.json();
        if (res.ok && data.success) {
          const targetUrlEl = document.getElementById('deploy-target-url') as HTMLAnchorElement | null;
          const remoteRepoEl = document.getElementById('deploy-remote-repo') as HTMLAnchorElement | null;
          const workflowLinkEl = document.getElementById('deploy-workflow-url') as HTMLAnchorElement | null;
          const statusBadge = document.getElementById('gh-pages-status-badge');

          if (targetUrlEl && data.pagesUrl) {
            targetUrlEl.href = data.pagesUrl;
            targetUrlEl.textContent = data.pagesUrl;
          }
          if (remoteRepoEl && data.remote) {
            remoteRepoWebUrl = data.remote.replace(/^git@github\.com:/, 'https://github.com/').replace(/\.git$/, '');
            remoteRepoEl.href = remoteRepoWebUrl;
            remoteRepoEl.textContent = data.remote;
          }
          if (workflowLinkEl && data.workflowUrl) {
            workflowLinkEl.href = data.workflowUrl;
            workflowLinkEl.classList.remove('hidden');
          }
          if (statusBadge && data.pagesStatus) {
            statusBadge.textContent = `Status: ${data.pagesStatus}`;
          }

          if (data.deployTargets) {
            if (data.deployTargets.vercel) {
              const el = document.getElementById('target-url-vercel') as HTMLInputElement | null;
              if (el) el.value = data.deployTargets.vercel;
              updateLiveUrlDisplay('vercel', data.deployTargets.vercel);
            }
            if (data.deployTargets.netlify) {
              const el = document.getElementById('target-url-netlify') as HTMLInputElement | null;
              if (el) el.value = data.deployTargets.netlify;
              updateLiveUrlDisplay('netlify', data.deployTargets.netlify);
            }
            if (data.deployTargets.cloudflare) {
              const el = document.getElementById('target-url-cloudflare') as HTMLInputElement | null;
              if (el) el.value = data.deployTargets.cloudflare;
              updateLiveUrlDisplay('cloudflare', data.deployTargets.cloudflare);
            }
          }
        }
      } catch {}
    }

    checkAuthStatus();
    checkDeployStatus();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSettingsTab);
  } else {
    initSettingsTab();
  }
  document.addEventListener('astro:page-load', initSettingsTab);
</script>
