        subtabStandaloneBtn.className = 'px-3 py-1 font-bold rounded-[2px] bg-read-accent text-read-bg-base cursor-pointer';
        subtabSeriesBtn.className = 'px-3 py-1 text-read-text-secondary hover:text-read-text-primary rounded-[2px] cursor-pointer';
