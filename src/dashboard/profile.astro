---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import TagBadge from '@/components/TagBadge.astro';
import FileUploadTab from '@/components/dashboard/FileUploadTab.astro';
import SettingsTab from '@/components/dashboard/SettingsTab.astro';
import TabBar from '@/components/chrome/TabBar.astro';
import OnboardingWizard from '@/components/dashboard/OnboardingWizard.astro';
import profileData from '../../profile.json';
import { siteConfig, getRelativePath } from '@/site.config';
import { getReadingTime } from '@/lib/reading-time';

// Fetch all published posts from repository
const userPosts = await getCollection('blog', ({ data }) => !data.draft);
userPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Compute user's blog stats directly from published articles
const totalPosts = userPosts.length;
const totalWords = userPosts.reduce(
  (acc, post) => acc + (post.data.words || getReadingTime(post.body || '').words),
  0
);

// Author's blog series
const seriesMap = new Map<string, { total: number; posts: typeof userPosts }>();
userPosts.forEach((post) => {
  if (post.data.series) {
    if (!seriesMap.has(post.data.series)) {
      seriesMap.set(post.data.series, { total: post.data.seriesTotal || 0, posts: [] });
    }
    const current = seriesMap.get(post.data.series)!;
    if (post.data.seriesTotal && post.data.seriesTotal > current.total) {
      current.total = post.data.seriesTotal;
    }
    current.posts.push(post);
  }
});

// Author's topics/tags with counts
const tagCounts: Record<string, number> = {};
userPosts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const authorTags = Object.entries(tagCounts).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);

const dashboardTabs = [
  { id: 'file-upload', label: 'File Upload', active: true },
  { id: 'settings', label: 'Settings', active: false },
  { id: 'public-profile', label: 'Public Profile View', active: false },
];
---

<BaseLayout title="Pomegranate Dashboard" activePath="/profile">
  <OnboardingWizard initialProfile={profileData} />
  <div class="max-w-[1040px] mx-auto px-4 md:px-8 py-8 font-mono space-y-6">
    <!-- Dashboard Top Header Bar & Mode-Aware TabBar -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-read-border">
      <div class="flex items-center gap-2">
        <span class="text-read-accent font-bold text-base">&gt;</span>
        <h1 class="text-xl sm:text-2xl font-bold text-read-text-primary tracking-tight">
          Pomegranate Dashboard
        </h1>
        <span class="text-read-accent text-[10px] font-bold px-2 py-0.5 border border-read-border rounded-[2px] bg-read-bg-surface select-none">
          DEV // LOCALHOST
        </span>
      </div>

      <!-- Mode-Aware Tab Navigation (TUI & Standard) -->
      <TabBar tabs={dashboardTabs} />
    </div>

    <!-- Tab 1: File Upload Tab (Split Editor + Seam) -->
    <div id="tab-content-file-upload">
      <FileUploadTab />
    </div>

    <!-- Tab 2: Settings Tab (Appearance, Features, Posts, Deploy, Privacy, Advanced) -->
    <div id="tab-content-settings" class="hidden">
      <SettingsTab />
    </div>

    <!-- Tab 3: Public Profile View (Visitor Perspective & Published Feed) -->
    <div id="tab-content-public-profile" class="hidden max-w-[760px] mx-auto space-y-10">
      <!-- Public Profile Context -->
      <section class="flex flex-col space-y-3">
        <div class="flex items-center gap-2 text-read-accent text-[13px]">
          <span class="font-bold">$</span>
          <span class="text-read-text-primary">whoami --profile</span>
        </div>
        <h2 class="text-[24px] sm:text-[26px] text-read-text-primary font-semibold tracking-tight">
          Public Author Profile
        </h2>
      </section>

      <!-- Profile Header Block -->
      <section class="flex flex-col sm:flex-row gap-6 items-start p-5 bg-read-bg-surface border border-read-border rounded-[2px]">
        <!-- Avatar / Logo Container -->
        <div class="relative shrink-0" id="profile-avatar-wrapper">
          <div
            id="profile-avatar-box"
            class="w-[100px] h-[100px] bg-read-bg-base border border-read-border relative overflow-hidden select-none flex flex-col items-center justify-center rounded-[2px]"
          >
            <img
              id="profile-avatar-img"
              src={
                siteConfig.avatar || siteConfig.logo
                  ? getRelativePath(siteConfig.avatar || siteConfig.logo)
                  : ''
              }
              alt={`${siteConfig.author} Logo`}
              class={`w-full h-full object-cover ${siteConfig.avatar || siteConfig.logo ? '' : 'hidden'}`}
              data-profile-logo-img
              onerror="this.classList.add('hidden'); const fallback = document.getElementById('profile-avatar-fallback'); if (fallback) fallback.classList.remove('hidden');"
            />
            <div
              id="profile-avatar-fallback"
              class={`flex flex-col items-center justify-center w-full h-full p-2 ${siteConfig.avatar || siteConfig.logo ? 'hidden' : ''}`}
              data-profile-logo-fallback
            >
              <span class="text-read-accent text-[32px] font-bold leading-none">&gt;_</span>
              <span
                class="text-read-accent font-semibold text-[11px] mt-1.5 truncate max-w-full"
                data-profile-handle
              >
                {siteConfig.handle}
              </span>
            </div>
          </div>
        </div>

        <!-- Author Bio & Coordinates -->
        <div class="flex flex-col space-y-3 flex-1 text-[13px] text-read-text-secondary leading-relaxed">
          <div>
            <h3
              class="text-[18px] text-read-text-primary font-semibold tracking-tight break-words"
              data-profile-author
            >
              {siteConfig.author || siteConfig.handle || 'User'}
            </h3>
            <p
              class={`text-[12px] text-read-accent mt-0.5 ${siteConfig.role ? '' : 'hidden'}`}
              data-profile-role
            >
              {siteConfig.role}
            </p>
          </div>

          <p
            class={`break-words ${siteConfig.description ? '' : 'text-read-text-tertiary italic text-[12px]'}`}
            data-profile-bio
          >
            {siteConfig.description || 'No description provided yet.'}
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-1 text-[12px]">
            {siteConfig.githubUrl && (
              <a
                href={siteConfig.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-read-text-primary hover:text-read-accent hover:underline underline-offset-4 transition-colors flex items-center gap-1 font-medium"
              >
                <span>GitHub: {siteConfig.handle}</span>
              </a>
            )}
            {siteConfig.twitterUrl && (
              <>
                <span class="text-read-text-tertiary">·</span>
                <a
                  href={siteConfig.twitterUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-read-text-primary hover:text-read-accent hover:underline underline-offset-4 transition-colors flex items-center gap-1 font-medium"
                >
                  <span>Twitter: {siteConfig.twitterHandle}</span>
                </a>
              </>
            )}
            {siteConfig.email && (
              <>
                <span class="text-read-text-tertiary">·</span>
                <a
                  href={`mailto:${siteConfig.email}`}
                  class="text-read-text-primary hover:text-read-accent hover:underline underline-offset-4 transition-colors flex items-center gap-1 font-medium"
                >
                  <span>{siteConfig.email}</span>
                </a>
              </>
            )}
            <span class="text-read-text-tertiary">·</span>
            <a
              href={getRelativePath('/feed.xml')}
              class="text-read-accent hover:underline underline-offset-4 transition-colors flex items-center gap-1 font-medium"
            >
              <span>RSS Feed</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Blog Telemetry & Activity Stats -->
      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-[12px]">
        <div class="p-3 bg-read-bg-surface border border-read-border rounded-[2px]">
          <div class="text-[10px] text-read-text-tertiary uppercase tracking-wider">Articles</div>
          <div class="text-[18px] text-read-accent font-bold mt-1">{totalPosts}</div>
        </div>
        <div class="p-3 bg-read-bg-surface border border-read-border rounded-[2px]">
          <div class="text-[10px] text-read-text-tertiary uppercase tracking-wider">Series</div>
          <div class="text-[18px] text-read-text-primary font-bold mt-1">{seriesMap.size}</div>
        </div>
        <div class="p-3 bg-read-bg-surface border border-read-border rounded-[2px]">
          <div class="text-[10px] text-read-text-tertiary uppercase tracking-wider">Topics</div>
          <div class="text-[18px] text-read-text-primary font-bold mt-1">{authorTags.length}</div>
        </div>
        <div class="p-3 bg-read-bg-surface border border-read-border rounded-[2px]">
          <div class="text-[10px] text-read-text-tertiary uppercase tracking-wider">
            Total Words
          </div>
          <div class="text-[18px] text-read-text-tertiary font-bold mt-1">
            ~{totalWords.toLocaleString()}
          </div>
        </div>
      </section>

      <!-- Author's Blog Series -->
      {seriesMap.size > 0 && (
        <section class="space-y-4 pt-4 border-t border-read-border">
          <div class="flex items-center gap-2 text-[11px] text-read-text-tertiary uppercase tracking-wider">
            <span class="text-read-accent font-bold">&gt;</span>
            <span>Featured Writing Series</span>
          </div>

          <div class="space-y-3">
            {[...seriesMap.entries()].map(([seriesName, data]) => (
              <div class="p-3.5 bg-read-bg-surface border border-read-border rounded-[2px] space-y-2">
                <div class="flex items-center justify-between text-[12px] gap-2">
                  <span class="text-read-text-primary font-semibold break-words">
                    '{seriesName}'
                  </span>
                  <span class="text-read-text-tertiary text-[11px] shrink-0">
                    {data.posts.length} {data.posts.length === 1 ? 'part' : 'parts'} published
                    {data.total > data.posts.length
                      ? ` (${data.posts.length}/${data.total} total)`
                      : ''}
                  </span>
                </div>
                <div class="flex flex-wrap gap-2 pt-1">
                  {data.posts
                    .sort((a, b) => (a.data.seriesPart || 0) - (b.data.seriesPart || 0))
                    .map((p) => {
                      const slug = p.id.replace(/\.(md|mdx)$/, '');
                      const totalPart = p.data.seriesTotal || data.total;
                      return (
                        <a
                          href={getRelativePath(`/blog/${slug}`)}
                          class="px-2.5 py-1 bg-read-bg-base border border-read-border hover:border-read-accent text-read-text-secondary hover:text-read-accent text-[11px] rounded-[2px] transition-colors flex items-center gap-1.5"
                        >
                          <span class="text-read-accent font-bold">
                            [{p.data.seriesPart}
                            {totalPart ? `/${totalPart}` : ''}]
                          </span>
                          <span class="truncate max-w-[200px] sm:max-w-[300px]">
                            {p.data.title}
                          </span>
                        </a>
                      );
                    })}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Topics Covered by this Author -->
      <section class="space-y-4 pt-4 border-t border-read-border">
        <div class="flex items-center justify-between text-[11px] text-read-text-tertiary uppercase tracking-wider">
          <div class="flex items-center gap-2">
            <span class="text-read-accent font-bold">&gt;</span>
            <span>Topics &amp; Tags</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {authorTags.map(([tag, count]) => (
            <TagBadge tag={tag} count={count} size="md" />
          ))}
        </div>
      </section>

      <!-- Author's Blog Articles Feed -->
      <section class="space-y-4 pt-4 border-t border-read-border">
        <div class="flex items-center justify-between text-[11px] text-read-text-tertiary uppercase tracking-wider">
          <div class="flex items-center gap-2">
            <span class="text-read-accent font-bold">&gt;</span>
            <span>Published Posts</span>
          </div>
          <span class="text-read-text-tertiary font-mono text-[11px]">
            {userPosts.length} entries
          </span>
        </div>

        <div class="flex flex-col space-y-6">
          {userPosts.map((post, idx) => (
            <PostCard post={post} showDivider={idx > 0} />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  function initDashboardNavigation() {
    const tabTriggers = document.querySelectorAll('[data-tab-id]');
    const tabPanels: Record<string, HTMLElement | null> = {
      'file-upload': document.getElementById('tab-content-file-upload'),
      settings: document.getElementById('tab-content-settings'),
      'public-profile': document.getElementById('tab-content-public-profile'),
    };

    function switchActiveTab(targetId: string) {
      localStorage.setItem('pomegranate_active_tab', targetId);
      localStorage.removeItem('blogly_active_tab');

      tabTriggers.forEach((btn) => {
        const id = btn.getAttribute('data-tab-id');
        const isActive = id === targetId;

        // TUI mode styling
        if (btn.classList.contains('chrome-tui-inline') || btn.closest('.chrome-tui-inline')) {
          if (isActive) {
            btn.classList.add(
              'bg-read-accent-fill',
              'text-[#FDF8F5]',
              'border-read-accent-fill',
              'font-bold'
            );
            btn.classList.remove('border-read-border-strong', 'text-read-text-secondary');
          } else {
            btn.classList.remove(
              'bg-read-accent-fill',
              'text-[#FDF8F5]',
              'border-read-accent-fill',
              'font-bold'
            );
            btn.classList.add('border-read-border-strong', 'text-read-text-secondary');
          }
        }

        // Standard mode styling
        if (isActive) {
          btn.classList.add('bg-read-bg-surface', 'text-read-accent', 'shadow-sm', 'font-semibold');
          btn.classList.remove('text-read-text-secondary');
        } else {
          btn.classList.remove(
            'bg-read-bg-surface',
            'text-read-accent',
            'shadow-sm',
            'font-semibold'
          );
          btn.classList.add('text-read-text-secondary');
        }
      });

      for (const [panelId, panelEl] of Object.entries(tabPanels)) {
        if (panelEl) {
          if (panelId === targetId) {
            panelEl.classList.remove('hidden');
          } else {
            panelEl.classList.add('hidden');
          }
        }
      }
    }

    tabTriggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const tabId = trigger.getAttribute('data-tab-id');
        if (tabId) {
          switchActiveTab(tabId);
        }
      });
    });

    // Support query param or localStorage tab memory
    const urlParams = new URLSearchParams(window.location.search);
    const queryTab = urlParams.get('tab');
    const defaultTab = 'file-upload';
    let storedTab = localStorage.getItem('pomegranate_active_tab');
    if (!storedTab) {
      const legacyTab = localStorage.getItem('blogly_active_tab');
      if (legacyTab) {
        storedTab = legacyTab;
        try {
          localStorage.setItem('pomegranate_active_tab', legacyTab);
          localStorage.removeItem('blogly_active_tab');
        } catch {}
      }
    }
    const initialTab =
      queryTab && tabPanels[queryTab]
        ? queryTab
        : storedTab && tabPanels[storedTab]
          ? storedTab
          : defaultTab;
    switchActiveTab(initialTab);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboardNavigation);
  } else {
    initDashboardNavigation();
  }
  document.addEventListener('astro:page-load', initDashboardNavigation);
</script>
