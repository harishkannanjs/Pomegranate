---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import { siteConfig, getRelativePath } from '@/site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  article?: boolean;
  pubDate?: Date;
  activePath?: string;
  theme?: string;
  mode?: 'dark' | 'light';
}

const {
  title = siteConfig.name || 'Pomegranate',
  description = siteConfig.description,
  image = '/og/default.png',
  canonicalUrl = Astro.url.href,
  article = false,
  pubDate,
  activePath = Astro.url.pathname,
  theme = 'catppuccin',
  mode = 'dark',
} = Astro.props;

const pageTitle = title || siteConfig.name || 'Pomegranate';
const resolvedOgImage = new URL(getRelativePath(image), Astro.site || Astro.url.origin).href;
---

<!doctype html>
<html lang="en" class={mode === 'light' ? 'light' : 'dark'} data-theme={theme} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={getRelativePath('/favicon.png')} />
    <link rel="icon" type="image/x-icon" href={getRelativePath('/favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={getRelativePath('/feed.xml')} />
    <link rel="sitemap" href={getRelativePath('/sitemap-index.xml')} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />

    <!-- Inline script to prevent FOUC (flash of unstyled theme) -->
    <script is:inline>
      (function() {
        const savedMode = localStorage.getItem('mode') || localStorage.getItem('theme') || 'dark';
        const savedThemePack = localStorage.getItem('theme-pack') || document.documentElement.getAttribute('data-theme') || 'catppuccin';
        const isDark = savedMode !== 'light';
        document.documentElement.setAttribute('data-theme', savedThemePack);
        document.documentElement.setAttribute('data-mode', isDark ? 'dark' : 'light');
        if (isDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      })();
      document.addEventListener('astro:after-swap', () => {
        const savedMode = localStorage.getItem('mode') || localStorage.getItem('theme') || 'dark';
        const savedThemePack = localStorage.getItem('theme-pack') || 'catppuccin';
        const isDark = savedMode !== 'light';
        document.documentElement.setAttribute('data-theme', savedThemePack);
        document.documentElement.setAttribute('data-mode', isDark ? 'dark' : 'light');
        if (isDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      });
    </script>

    <!-- Cookie-Free Privacy Analytics (Active when opt-in enabled in profile.json or localStorage) -->
    <script is:inline>
      (function() {
        try {
          const storedPrivacy = localStorage.getItem('pomegranate_privacy');
          const isEnabled = storedPrivacy ? JSON.parse(storedPrivacy).analytics : false;
          if (isEnabled && typeof window !== 'undefined') {
            window.dispatchEvent(new CustomEvent('pomegranate:analytics', {
              detail: {
                path: window.location.pathname,
                referrer: document.referrer || null,
                timestamp: Date.now(),
              }
            }));
          }
        } catch {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="bg-surface font-mono text-[14px] text-on-surface antialiased selection:bg-primary selection:text-on-primary min-h-screen flex flex-col justify-between transition-colors">
    <Header activePath={activePath} />

    <main class="w-full pt-14 flex-1">
      <slot />
    </main>

    <Footer />
    <CommandPalette />
  </body>
</html>
