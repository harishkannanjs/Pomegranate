---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ReadingProgressBar from '@/components/ReadingProgressBar.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import TagBadge from '@/components/TagBadge.astro';
import SeriesStrip from '@/components/SeriesStrip.astro';
import ChangelogPopover from '@/components/ChangelogPopover.astro';
import CopyMarkdownButton from '@/components/CopyMarkdownButton.astro';
import CopyLinkButton from '@/components/CopyLinkButton.astro';
import AudioReader from '@/components/AudioReader.astro';
import ReaderModeButton from '@/components/ReaderModeButton.astro';
import TextMagnifier from '@/components/TextMagnifier.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import PrevNextNav from '@/components/PrevNextNav.astro';
import GiscusComments from '@/components/GiscusComments.astro';
import CodeBlockEnhancer from '@/components/CodeBlockEnhancer.astro';
import { getReadingTime } from '@/lib/reading-time';
import { getSeriesInfo } from '@/lib/series';
import { siteConfig, getRelativePath } from '@/site.config';

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
  headings: { depth: number; slug: string; text: string }[];
  prevPost?: CollectionEntry<'blog'> | null;
  nextPost?: CollectionEntry<'blog'> | null;
  theme?: import('@/lib/themes').ThemeId;
  mode?: import('@/lib/themes').ColorMode;
}

const { post, allPosts, headings, prevPost, nextPost, theme, mode } = Astro.props;
const slug = post.id.replace(/\.(md|mdx)$/, '');
const reading = getReadingTime(post.body || '');
const seriesInfo = getSeriesInfo(post, allPosts);

const pubDateStr = new Date(post.data.pubDate).toISOString().split('T')[0];
const updatedDateStr = post.data.updatedDate
  ? new Date(post.data.updatedDate).toISOString().split('T')[0]
  : null;

// Repository directory segments for breadcrumb
const normalizedId = post.id.replace(/\\/g, '/');
const dirSegments = normalizedId.split('/');
const rootUrl = getRelativePath('/');

const features = {
  audioReader: true,
  readerMode: true,
  textMagnifier: true,
  copyLink: true,
  copyMarkdown: true,
  tableOfContents: true,
  readingProgressBar: true,
  relatedPosts: true,
  ...(siteConfig.features || {}),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={getRelativePath(`/og/${slug}.png`)}
  article={true}
  pubDate={post.data.pubDate}
  activePath="/blog"
  theme={theme}
  mode={mode}
>
  {features.readingProgressBar && (
    <div data-feature="readingProgressBar">
      <ReadingProgressBar />
    </div>
  )}

  <div class="max-w-[1040px] mx-auto px-4 md:px-8 py-8">
    <!-- Directory of the blog -->
    <div class="flex items-center gap-1.5 text-[11px] text-outline mb-4 font-mono overflow-x-auto whitespace-nowrap">
      <span class="text-primary font-bold">&gt;</span>
      <a href={rootUrl} class="hover:text-primary transition-colors font-medium">ROOT</a>
      <span class="text-outline-variant">/</span>
      <a href={rootUrl} class="hover:text-primary transition-colors font-medium">Blogs</a>
      {dirSegments.map((segment, idx) => (
        <>
          <span class="text-outline-variant">/</span>
          {idx === dirSegments.length - 1 ? (
            <span class="text-primary font-semibold">{segment}</span>
          ) : (
            <span class="text-on-surface-variant">{segment}</span>
          )}
        </>
      ))}
    </div>

    <!-- Main 2-column layout (content + sticky TOC) -->
    <div class="relative grid grid-cols-1 lg:grid-cols-[1fr_240px] gap-10">
      <!-- Article Column -->
      <article class="max-w-[680px] w-full min-w-0" data-pagefind-body>
        <!-- Header -->
        <header class="mb-8 font-mono">
          <h1
            class="text-[26px] sm:text-[28px] text-on-surface mb-3 font-semibold tracking-tight leading-snug font-mono break-words"
            transition:name={`post-title-${slug}`}
            data-pagefind-meta="title"
          >
            {post.data.title}
          </h1>

          <!-- Meta bar -->
          <div class="relative text-[13px] text-on-surface-variant flex flex-wrap items-center gap-x-3 gap-y-1 py-1 mb-4">
            <span># Published {pubDateStr}</span>
            {updatedDateStr && (
              <>
                <span class="text-outline-variant">·</span>
                <span>Updated {updatedDateStr}</span>
              </>
            )}
            <span class="text-outline-variant">·</span>
            <span>{reading.text}</span>
            {post.data.changelog && post.data.changelog.length > 0 && (
              <>
                <span class="text-outline-variant">·</span>
                <ChangelogPopover changelog={post.data.changelog} />
              </>
            )}
          </div>

          <!-- Top Bar Section: Tags -> Play Audio -> Copy Link -> Copy as Markdown -->
          <div class="flex items-center justify-between flex-wrap gap-3 py-2 bg-surface-container-low px-3 rounded-[2px] border border-outline-variant">
            <!-- Left: Tags -->
            <div class="flex items-center gap-1.5 flex-wrap">
              {post.data.tags.map((tag) => (
                <TagBadge tag={tag} />
              ))}
            </div>

            <!-- Right: Play Audio -> Reader's Mode (Eye Comfort) -> Text Magnifier -> Copy Link -> Copy as Markdown -->
            <div class="flex items-center gap-2">
              {features.audioReader && <div data-feature="audioReader"><AudioReader /></div>}
              {features.readerMode && <div data-feature="readerMode"><ReaderModeButton /></div>}
              {features.textMagnifier && <div data-feature="textMagnifier"><TextMagnifier /></div>}
              {features.copyLink && <div data-feature="copyLink"><CopyLinkButton /></div>}
              {features.copyMarkdown && <div data-feature="copyMarkdown"><CopyMarkdownButton rawContent={post.body || ''} /></div>}
            </div>
          </div>

          <!-- Series Strip if applicable -->
          {seriesInfo && <SeriesStrip seriesInfo={seriesInfo} />}
        </header>

        <!-- Inline Table of Contents for viewports <1280px -->
        {features.tableOfContents && (
          <div data-feature="tableOfContents">
            <TableOfContents headings={headings} mode="inline" />
          </div>
        )}

        <!-- Prose Article Body -->
        <section class="prose prose-invert max-w-none text-on-surface leading-relaxed text-[14px]">
          <slot />
        </section>

        <!-- Previous + next entry -->
        <div class="reader-mode-hide">
          <PrevNextNav prevPost={prevPost} nextPost={nextPost} />
        </div>

        <!-- Related Teardowns & Research -->
        {features.relatedPosts && (
          <div class="reader-mode-hide" data-feature="relatedPosts">
            <RelatedPosts currentPost={post} allPosts={allPosts} />
          </div>
        )}

        <!-- Comments Section (Powered by Giscus, Zero Server) -->
        <div class="reader-mode-hide">
          <GiscusComments postTitle={post.data.title} postSlug={post.id} />
        </div>
      </article>

      <!-- Sticky Rail Table of Contents for viewports >=1280px -->
      {features.tableOfContents && (
        <div data-feature="tableOfContents">
          <TableOfContents headings={headings} mode="rail" />
        </div>
      )}
    </div>
  </div>

  <CodeBlockEnhancer />

  <!-- Heading Anchors Client Script -->
  <script is:inline>
    function initHeadingAnchors() {
      const headings = document.querySelectorAll('article h2, article h3');
      headings.forEach((heading) => {
        if (!heading.id || heading.querySelector('.heading-anchor')) return;

        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor text-outline hover:text-primary transition-opacity opacity-0 group-hover:opacity-100 ml-2 font-mono text-[14px] inline-block select-none cursor-pointer';
        anchor.href = `#${heading.id}`;
        anchor.innerHTML = '#';
        anchor.title = 'Copy permanent link';

        heading.classList.add('group', 'relative');
        heading.appendChild(anchor);

        anchor.onclick = async (e) => {
          e.preventDefault();
          const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
          try {
            await navigator.clipboard.writeText(url);
            anchor.innerHTML = '[Copied!]';
            anchor.classList.add('text-primary');
            history.pushState(null, '', `#${heading.id}`);
            setTimeout(() => {
              anchor.innerHTML = '#';
              anchor.classList.remove('text-primary');
            }, 1800);
          } catch (err) {
            // fallback
          }

          const isReader = document.documentElement.classList.contains('reader-mode-active');
          const headerOffset = isReader ? 28 : 80;
          const elementPosition = heading.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth',
          });
        };
      });
    }

    function applyLiveFeatureToggles() {
      try {
        const raw = localStorage.getItem('blogly_features');
        if (raw) {
          const map = JSON.parse(raw);
          for (const [key, enabled] of Object.entries(map)) {
            const els = document.querySelectorAll(`[data-feature="${key}"]`);
            els.forEach((el) => {
              if (!enabled) {
                el.setAttribute('style', 'display: none !important');
              } else {
                el.style.removeProperty('display');
              }
            });
          }
        }
      } catch {}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initHeadingAnchors();
        applyLiveFeatureToggles();
      });
    } else {
      initHeadingAnchors();
      applyLiveFeatureToggles();
    }
    document.addEventListener('astro:page-load', () => {
      initHeadingAnchors();
      applyLiveFeatureToggles();
    });
    document.addEventListener('astro:after-swap', () => {
      initHeadingAnchors();
      applyLiveFeatureToggles();
    });
    window.addEventListener('storage', applyLiveFeatureToggles);
  </script>
</BaseLayout>
