---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig, getRelativePath } from '@/site.config';
---

<BaseLayout title="404: Not Found">
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 py-12 font-mono">
    <section class="flex flex-col space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-primary font-bold">&gt;</span>
          <span class="text-primary text-[13px] uppercase tracking-wider font-semibold">status: 404_buffer_unallocated</span>
        </div>
        <span class="text-outline text-[11px]">[ERR_NOT_FOUND]</span>
      </div>

      <!-- Terminal Output Frame -->
      <div class="border border-outline-variant rounded-[2px] p-6 bg-surface-container-low space-y-6">
        <div class="space-y-2 border-b border-outline-variant/60 pb-4">
          <div class="text-[28px] text-error font-bold tracking-tight flex items-center gap-3">
            <span>404</span>
            <span class="text-outline font-normal text-[20px]">/</span>
            <span class="text-on-surface text-[18px] font-medium">Page Buffer Missing</span>
          </div>
          <p class="text-on-surface-variant text-[13px] leading-relaxed">
            The requested memory address or route does not point to an active research note, standalone writeup, or series part.
          </p>
        </div>

        <!-- Terminal Diagnostic Code Block -->
        <div class="bg-surface-container-lowest border border-outline-variant p-4 text-[12px] space-y-1.5 overflow-x-auto select-all">
          <div class="text-outline flex items-center gap-2">
            <span class="text-primary">$</span>
            <span>diagnose --strict --target=current_url</span>
          </div>
          <div class="text-on-surface pl-3 border-l-2 border-outline-variant/50 space-y-1 py-1">
            <p>[*] Probing local route cache... <span class="text-error font-semibold">FAILED</span></p>
            <p>[*] Status: HTTP 404 Object Not Found in Blogs/ directory.</p>
            <p>[*] Hint: Verify casing or utilize client fuzzy search (Ctrl+K or /).</p>
          </div>
        </div>

        <div class="space-y-3 pt-1">
          <div class="text-[12px] text-outline flex items-center gap-2">
            <span class="text-primary">&gt;</span>
            <span class="text-on-surface font-semibold">Possible causes:</span>
          </div>
          <ul class="list-disc list-inside text-[12px] text-on-surface-variant space-y-1 pl-2">
            <li>Article is marked as <code class="text-primary">draft: true</code> in frontmatter (hidden in production).</li>
            <li>File was relocated, renamed, or series part directory was restructured.</li>
            <li>URL typo or outdated search bookmark.</li>
          </ul>

          <!-- Prompt recovery line with action prompts -->
          <div class="pt-2 border-t border-outline-variant/60 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-[13px]">
            <div class="flex items-center gap-2 text-primary font-bold">
              <span>&gt;</span>
              <span class="text-on-surface-variant font-normal">Resolution paths:</span>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <a
                class="inline-flex items-center gap-1 bg-surface-container hover:bg-surface-container-high border border-outline-variant hover:border-primary text-on-surface hover:text-primary px-2.5 py-0.5 transition-colors"
                href={getRelativePath('/')}
              >
                <span>[Home]</span>
              </a>
              <button
                class="inline-flex items-center gap-1 bg-surface-container hover:bg-surface-container-high border border-outline-variant hover:border-primary text-on-surface hover:text-primary px-2.5 py-0.5 transition-colors cursor-pointer"
                data-open-search
                type="button"
              >
                <span>[Search]</span>
                <span class="text-outline text-[11px]">(hit <kbd class="text-primary font-mono">/</kbd>)</span>
              </button>
            </div>
          </div>

          <!-- Blinking caret active state -->
          <div class="flex items-center gap-2 pt-1">
            <span class="text-primary font-bold">{siteConfig.handle ? siteConfig.handle.replace(/^@/, '') : 'user'}@terminal:~$</span>
            <span class="inline-block w-2.5 h-4 bg-primary animate-pulse align-middle"></span>
          </div>
        </div>
      </div>

      <!-- Micro Diagnostic Footnote -->
      <div class="flex items-center justify-between text-[11px] text-outline px-1">
        <span>POSIX standard return exit code 127</span>
        <span>fault_addr: 0x0000000000000000</span>
      </div>
    </section>
  </div>
</BaseLayout>
