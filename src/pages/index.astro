---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import TagBadge from '@/components/TagBadge.astro';
import { siteConfig, getRelativePath } from '@/site.config';
import { getReadingTime } from '@/lib/reading-time';

// Fetch all published posts sorted by date descending
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Compute summary stats
const totalWords = allPosts.reduce(
  (acc, post) => acc + (post.data.words || getReadingTime(post.body || '').words),
  0
);

// Collect series information
const seriesMap = new Map<string, { total: number; posts: typeof allPosts }>();
allPosts.forEach((post) => {
  if (post.data.series) {
    if (!seriesMap.has(post.data.series)) {
      seriesMap.set(post.data.series, { total: post.data.seriesTotal || 0, posts: [] });
    }
    const current = seriesMap.get(post.data.series)!;
    if (post.data.seriesTotal && post.data.seriesTotal > current.total) {
      current.total = post.data.seriesTotal;
    }
    current.posts.push(post);
  }
});

// Collect top tags
const tagCounts: Record<string, number> = {};
allPosts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12);

const isDev = import.meta.env.DEV;
const targetProfileUrl = isDev ? getRelativePath('/profile/') : getRelativePath('/about/');
const avatarSrc = siteConfig.avatar || siteConfig.logo ? getRelativePath(siteConfig.avatar || siteConfig.logo) : '';
---

<BaseLayout title="Home" activePath="/">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-8 font-mono">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] xl:grid-cols-[1fr_380px] gap-10 xl:gap-14 items-start w-full">
      <!-- Main Content: Intro & Articles Stream -->
      <div class="flex flex-col w-full min-w-0">
        <!-- Bear Blog Minimalist Author Greeting & Manifesto -->
        <header class="pb-7 mb-7 border-b border-outline-variant/40 space-y-3">
          <div class="flex items-center gap-3">
            {avatarSrc && (
              <div class="w-10 h-10 rounded-[2px] border border-outline-variant overflow-hidden shrink-0 bg-surface-container">
                <img
                  src={avatarSrc}
                  alt={`${siteConfig.author} avatar`}
                  class="w-full h-full object-cover"
                />
              </div>
            )}
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-primary font-bold select-none">&gt;</span>
                <h1 class="text-on-surface font-semibold text-[17px] sm:text-[19px] tracking-tight">
                  {siteConfig.author || siteConfig.name}
                </h1>
                {siteConfig.handle && (
                  <span class="text-outline text-[12px] font-mono">({siteConfig.handle})</span>
                )}
              </div>
              {siteConfig.role && (
                <p class="text-[12px] text-primary font-medium mt-0.5 tracking-wide">
                  {siteConfig.role}
                </p>
              )}
            </div>
          </div>

          {siteConfig.description && (
            <p class="text-[13px] text-on-surface-variant leading-relaxed max-w-[700px]">
              {siteConfig.description}
            </p>
          )}

          <!-- Minimalist Coordinates Line -->
          <div class="flex items-center gap-3 pt-1 text-[11px] text-outline flex-wrap font-mono">
            {siteConfig.githubUrl && (
              <a
                href={siteConfig.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary hover:underline underline-offset-4 transition-colors"
              >
                github
              </a>
            )}
            {siteConfig.twitterUrl && (
              <>
                <span class="text-outline-variant">·</span>
                <a
                  href={siteConfig.twitterUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-primary hover:underline underline-offset-4 transition-colors"
                >
                  twitter
                </a>
              </>
            )}
            {siteConfig.email && (
              <>
                <span class="text-outline-variant">·</span>
                <a
                  href={`mailto:${siteConfig.email}`}
                  class="hover:text-primary hover:underline underline-offset-4 transition-colors"
                >
                  email
                </a>
              </>
            )}
            <span class="text-outline-variant">·</span>
            <a
              href={getRelativePath('/feed.xml')}
              class="text-primary hover:underline underline-offset-4 transition-colors"
            >
              rss
            </a>
            <span class="text-outline-variant">·</span>
            <a
              href={targetProfileUrl}
              class="text-outline hover:text-primary hover:underline underline-offset-4 transition-colors"
            >
              {isDev ? 'dashboard' : 'about'}
            </a>
          </div>
        </header>

        <!-- Clean Posts Section Header (Bear Blog aesthetic) -->
        <div class="flex items-center justify-between pb-3 mb-2 border-b border-outline-variant/40 text-[11px] font-mono uppercase tracking-wider text-outline">
          <div class="flex items-center gap-2">
            <span class="text-primary font-bold">&gt;</span>
            <span class="text-on-surface font-semibold lowercase text-[13px]">Recent Articles</span>
          </div>
          <div class="flex items-center gap-2">
            <span>{allPosts.length} {allPosts.length === 1 ? 'entry' : 'entries'}</span>
            <span class="text-outline-variant">·</span>
            <span class="text-primary font-semibold">[live]</span>
          </div>
        </div>

        <!-- Post List (Date-anchored, calm, breathable) -->
        <div class="flex flex-col">
          {allPosts.map((post) => (
            <PostCard post={post} />
          ))}
          {allPosts.length === 0 && (
            <div class="py-12 text-center text-outline font-mono text-[13px]">
              No posts published in this buffer yet.
            </div>
          )}
        </div>

        <!-- Bottom Search & Prompt Bar -->
        <div class="mt-8 pt-4 border-t border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-[11px] font-mono text-outline">
          <div class="flex items-center gap-2 text-on-surface-variant">
            <span class="text-primary font-bold">&gt;_</span>
            <span>Type <kbd class="px-1.5 py-0.5 bg-surface-container border border-outline-variant text-primary rounded-[2px] font-bold">/</kbd> anywhere to search articles &amp; tags</span>
          </div>
          <button
            type="button"
            data-open-search
            class="text-primary hover:underline underline-offset-4 transition-colors cursor-pointer text-left sm:text-right shrink-0"
          >
            [Search Shell]
          </button>
        </div>
      </div>

      <!-- Right Column: Minimalist Typographic Rail -->
      <aside class="w-full space-y-8 lg:sticky lg:top-20 pt-1">
        <!-- Topics & Tags -->
        {topTags.length > 0 && (
          <div class="space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-outline-variant/40 text-[11px] font-mono uppercase tracking-wider text-outline">
              <div class="flex items-center gap-1.5">
                <span class="text-primary font-bold">&gt;</span>
                <span class="text-on-surface font-semibold lowercase text-[12px]">Topics &amp; Tags</span>
              </div>
              <span class="text-[10px] text-outline">[filter]</span>
            </div>

            <div class="flex flex-wrap gap-1.5 pt-0.5">
              {topTags.map(([tag, count]) => (
                <TagBadge tag={tag} count={count} size="sm" />
              ))}
            </div>
          </div>
        )}

        <!-- Featured Writing Series (if any) -->
        {seriesMap.size > 0 && (
          <div class="space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-outline-variant/40 text-[11px] font-mono uppercase tracking-wider text-outline">
              <div class="flex items-center gap-1.5">
                <span class="text-primary font-bold">&gt;</span>
                <span class="text-on-surface font-semibold lowercase text-[12px]">Writing Series</span>
              </div>
              <span class="text-[10px]">{seriesMap.size} active</span>
            </div>

            <div class="space-y-2">
              {[...seriesMap.entries()].slice(0, 3).map(([seriesName, data]) => (
                <div class="p-2.5 bg-surface-container-low border border-outline-variant/60 rounded-[2px] space-y-1.5">
                  <div class="flex items-center justify-between text-[11px] gap-2">
                    <span class="text-on-surface font-medium truncate">'{seriesName}'</span>
                    <span class="text-outline text-[10px] shrink-0">
                      {data.posts.length} {data.posts.length === 1 ? 'part' : 'parts'}
                    </span>
                  </div>
                  <div class="flex flex-wrap gap-1 pt-0.5">
                    {data.posts
                      .sort((a, b) => (a.data.seriesPart || 0) - (b.data.seriesPart || 0))
                      .slice(0, 4)
                      .map((p) => {
                        const slug = p.id.replace(/\.(md|mdx)$/, '');
                        return (
                          <a
                            href={getRelativePath(`/blog/${slug}`)}
                            class="px-1.5 py-0.5 bg-surface border border-outline-variant hover:border-primary text-on-surface-variant hover:text-primary text-[10px] rounded-[2px] transition-colors"
                            title={p.data.title}
                          >
                            Part {p.data.seriesPart || 1}
                          </a>
                        );
                      })}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Quiet Telemetry & Privacy -->
        <div class="pt-4 border-t border-outline-variant/30 space-y-2 text-[11px] text-outline font-mono">
          <div class="flex items-center justify-between">
            <span>Published articles</span>
            <span class="text-on-surface font-semibold">{allPosts.length}</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Total words</span>
            <span class="text-on-surface font-semibold">~{totalWords.toLocaleString()}</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Privacy stance</span>
            <span class="text-primary font-semibold">Zero cookies · No trackers</span>
          </div>
        </div>

        <!-- Terminal Keyboard Cheatsheet -->
        <div class="p-2.5 bg-surface-container-lowest border border-outline-variant/50 rounded-[2px] space-y-1.5 text-[11px] text-outline font-mono">
          <div class="text-primary font-semibold flex items-center gap-1.5">
            <span>&gt;_</span>
            <span>Shortcuts</span>
          </div>
          <div class="flex items-center justify-between pt-0.5">
            <span>Search</span>
            <kbd class="px-1 bg-surface-container border border-outline-variant text-primary rounded-[2px]">/</kbd>
          </div>
          <div class="flex items-center justify-between">
            <span>Eye comfort</span>
            <kbd class="px-1 bg-surface-container border border-outline-variant text-primary rounded-[2px]">Alt+R</kbd>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

